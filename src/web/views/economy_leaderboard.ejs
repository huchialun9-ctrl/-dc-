<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Economy Leaderboard | <%= guild.name %>
    </title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;700;800&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="container" style="padding-top: 4rem;">
        <div class="topbar">
            <div>
                <a href="/dashboard" class="btn-secondary" style="margin-bottom: 10px; display: inline-block;">
                    <i class="fa-solid fa-arrow-left"></i> 回到儀表板
                </a>
                <h2>🏆 <%= guild.name %> 富豪榜 (Top 50)</h2>
                <p style="color: var(--text-secondary);">最有錢的都在這！</p>
            </div>
        </div>

        <div class="glass-panel" style="padding: 0; overflow: hidden;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th width="80">排名</th>
                        <th>用戶</th>
                        <th width="200" style="text-align: right;">資產 (Balance)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (leaderboard.length===0) { %>
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 3rem;">
                                <i class="fa-solid fa-ghost"
                                    style="font-size: 2rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
                                <p>目前還沒有任何富豪誕生！</p>
                            </td>
                        </tr>
                        <% } else { %>
                            <% leaderboard.forEach(user=> { %>
                                <tr>
                                    <td>
                                        <% if (user.rank===1) { %>
                                            <i class="fa-solid fa-crown" style="color: #FFD700; font-size: 1.2rem;"></i>
                                            <% } else if (user.rank===2) { %>
                                                <i class="fa-solid fa-medal"
                                                    style="color: #C0C0C0; font-size: 1.2rem;"></i>
                                                <% } else if (user.rank===3) { %>
                                                    <i class="fa-solid fa-medal"
                                                        style="color: #CD7F32; font-size: 1.2rem;"></i>
                                                    <% } else { %>
                                                        <span class="badge"
                                                            style="background: rgba(0,0,0,0.1); color: var(--text-secondary);">#
                                                            <%= user.rank %>
                                                        </span>
                                                        <% } %>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <img src="<%= user.avatar %>" alt="Avatar"
                                                style="width: 32px; height: 32px; border-radius: 50%;">
                                            <span style="font-weight: 800; color: #D35400; font-size: 1.05rem;">
                                                <%= user.username %>
                                            </span>
                                        </div>
                                    </td>
                                    <td
                                        style="text-align: right; font-family: monospace; font-size: 1.1rem; color: #67C23A;">
                                        $<%= user.balance.toLocaleString() %>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>

</html>