                                        </select>
                                        <i class="fa-solid fa-hashtag"
                                            style="position: absolute; left: 1rem; top: 1.1rem; color: var(--text-muted); opacity: 0.5;"></i>
                                    </div>
                                    <div class="designer-tip" style="margin-top: 2rem;">
                                        <i class="fa-solid fa-microchip"></i>
                                        限制在單一頻道內對話，能讓 AI 的回應更具上下文邏輯，且不干擾其他討論。
                                    </div>
                                </div>

                                <div
                                    style="display: flex; justify-content: flex-end; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 2.5rem;">
                                    <button type="submit" class="save-btn"
                                        style="min-width: 200px; justify-content: center; height: 50px;">
                                        <i class="fa-solid fa-sync"></i> 重新掛載思維模組
                                    </button>
                                </div>
                            </form>
                            <div class="handwritten-note">"我在聽，我在思考。"</div>
                        </div>

                        <!-- AutoMod Config Redesigned -->
                        <div id="config-automod" class="config-section premium-card"
                            style="max-width: 800px; margin: 0 auto;">
                            <div class="card-header" style="justify-content: space-between; margin-bottom: 2.5rem;">
                                <div style="display: flex; align-items: center; gap: 1.25rem;">
                                    <div
                                        style="width: 44px; height: 44px; background: rgba(52, 211, 153, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-shield-halved"
                                            style="color: #34d399; font-size: 1.25rem;"></i>
                                    </div>
                                    <h3 style="font-size: 1.5rem;">自動審核與過濾核心</h3>
                                </div>
                                <button class="btn-reset" onclick="closeConfig()"
                                    style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                                    <i class="fa-solid fa-reply"></i> 返回列表
                                </button>
                            </div>

                            <form action="/dashboard/settings" method="POST" class="track-changes">
                                <input type="hidden" name="action" value="update_automod">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                <div class="form-group" style="margin-bottom: 2.5rem;">
                                    <label>敏感詞彙深度過濾 (Bad Words Filter)</label>
                                    <div style="position: relative; margin-top: 1rem;">
                                        <input type="text" name="automod_badwords" class="modern-input"
                                            value="<%= settings.automod_badwords %>" placeholder="垃圾, 廣告, 詐騙 (請以逗號分隔)"
                                            style="padding-left: 3rem;">
                                        <i class="fa-solid fa-comment-slash"
                                            style="position: absolute; left: 1rem; top: 1.1rem; color: var(--text-muted); opacity: 0.5;"></i>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem; flex-wrap: wrap;">
                                        <span class="status-badge"
                                            style="background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: none; font-size: 0.7rem; padding: 4px 12px;">立即攔截</span>
                                        <span class="status-badge"
                                            style="background: rgba(251, 191, 36, 0.1); color: #fbbf24; border: none; font-size: 0.7rem; padding: 4px 12px;">全時段監控</span>
                                        <span class="status-badge"
                                            style="background: rgba(99, 102, 241, 0.1); color: #6366f1; border: none; font-size: 0.7rem; padding: 4px 12px;">智能警報</span>
                                    </div>
                                    <div class="designer-tip" style="margin-top: 2rem;">
                                        <i class="fa-solid fa-shield-virus"></i>
                                        系統將自動比對訊息內容。若包含敏感詞，將立即刪除並對用戶發出柔性警告。
                                    </div>
                                </div>

                                <div
                                    style="display: flex; justify-content: flex-end; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 2.5rem;">
                                    <button type="submit" class="save-btn"
                                        style="min-width: 200px; justify-content: center; height: 50px;">
                                        <i class="fa-solid fa-shield-check"></i> 部署防護演算法
                                    </button>
                                </div>
                            </form>
                            <div class="handwritten-note">"安全，是第一要務。"</div>
                        </div>

                        <!-- Custom Commands Config Redesigned -->
                        <div id="config-commands" class="config-section premium-card"
                            style="max-width: 1000px; margin: 0 auto;">
                            <div class="card-header" style="justify-content: space-between; margin-bottom: 2.5rem;">
                                <div style="display: flex; align-items: center; gap: 1.25rem;">
                                    <div
                                        style="width: 44px; height: 44px; background: rgba(45, 212, 191, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-code" style="color: #2dd4bf; font-size: 1.25rem;"></i>
                                    </div>
                                    <h3 style="font-size: 1.5rem;">指令腳本資料庫管理員</h3>
                                </div>
                                <button class="btn-reset" onclick="closeConfig()"
                                    style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                                    <i class="fa-solid fa-reply"></i> 返回列表
                                </button>
                            </div>

                            <div
                                style="display: grid; grid-template-columns: 380px 1fr; gap: 2.5rem; align-items: start;">
                                <!-- Left: Command Creator -->
                                <div class="premium-card"
                                    style="padding: 1.5rem; background: rgba(255,255,255,0.02); border-radius: 20px; border: 1px solid rgba(255,255,255,0.05);">
                                    <h4
                                        style="margin-bottom: 1.5rem; font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">
                                        指令產生器 (Creator Engine)</h4>
                                    <form action="/dashboard/settings" method="POST">
                                        <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                        <input type="hidden" name="action" value="add_command">

                                        <div class="form-group">
                                            <label style="font-size: 0.75rem;">啟動關鍵字 (Activation Key)</label>
                                            <div style="position: relative;">
                                                <span
                                                    style="position: absolute; left: 1rem; top: 1.1rem; color: var(--accent-secondary); font-weight: 800;">!</span>
                                                <input type="text" name="trigger" class="modern-input"
                                                    placeholder="例如: hello" style="padding-left: 2rem;" required>
                                            </div>
                                        </div>
                                        <div class="form-group" style="margin-bottom: 2rem;">
                                            <label style="font-size: 0.75rem;">自動脈衝響應 (Pulse Response)</label>
                                            <textarea name="response" class="modern-input" rows="5"
                                                placeholder="輸入機器人應回應的訊息..." style="padding: 1rem; resize: none;"
                                                required></textarea>
                                        </div>
                                        <button type="submit" class="save-btn"
                                            style="width: 100%; justify-content: center; height: 48px;">
                                            <i class="fa-solid fa-plus-circle"></i> 燒錄新指令
                                        </button>
                                        <div class="designer-tip" style="margin-top: 1.5rem;">
                                            <i class="fa-solid fa-code-merge"></i>
                                            指令會立即生效，全伺服器通用。
                                        </div>
                                    </form>
                                </div>

                                <!-- Right: Commands List -->
                                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <h4
                                            style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">
                                            現存邏輯腳本 (<%= customCommands.length %>)</h4>
                                        <span class="status-badge"
                                            style="font-size: 0.7rem; background: rgba(255,255,255,0.05); color: var(--text-muted);">雙擊可展開內容</span>
                                    </div>

                                    <div style="max-height: 500px; overflow-y: auto; padding-right: 0.5rem;"
                                        class="premium-scrollbar">
                                        <% customCommands.forEach(cmd=> { %>
                                            <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 1.25rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: flex-start; transition: all 0.3s;"
                                                class="command-item-hover">
                                                <div style="flex: 1;">
                                                    <div
                                                        style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                                                        <div
                                                            style="padding: 4px 10px; background: rgba(45, 212, 191, 0.1); border-radius: 6px; color: #2dd4bf; font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 0.95rem;">
                                                            !<%= cmd.trigger %>
                                                        </div>
                                                    </div>
                                                    <p
                                                        style="margin: 0; color: var(--text-secondary); font-size: 0.88rem; line-height: 1.5; white-space: pre-wrap;">
                                                        <%= cmd.response %>
                                                    </p>
                                                </div>
                                                <form action="/dashboard/settings" method="POST"
                                                    style="margin-left: 1rem;">
                                                    <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                                    <input type="hidden" name="action" value="delete_command">
                                                    <input type="hidden" name="command_id" value="<%= cmd.id %>">
                                                    <button type="submit" class="btn-remove" title="永久移除"
                                                        style="width: 38px; height: 38px;">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <% }) %>

                                                <% if (customCommands.length===0) { %>
                                                    <div
                                                        style="text-align: center; padding: 4rem; color: var(--text-muted); border: 2px dashed rgba(255,255,255,0.05); border-radius: 20px;">
                                                        <i class="fa-solid fa-terminal"
                                                            style="font-size: 2.5rem; margin-bottom: 1.5rem; opacity: 0.2;"></i>
                                                        <p style="font-size: 0.9rem;">目前尚未建立任何自訂指令</p>
                                                    </div>
                                                    <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

        </div>
        </div>

        <script>
            // --- Global Utilities ---
            function showToast(message, type = 'success') {
                let container = document.querySelector('.toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.className = 'toast-container';
                    document.body.appendChild(container);
                }
                const toast = document.createElement('div');
                toast.className = `toast ${type}`;
                toast.innerHTML = type === 'success'
                    ? `<i class="fa-solid fa-check-circle" style="color: #22C55E;"></i> <span>${message}</span>`
                    : `<i class="fa-solid fa-exclamation-circle" style="color: #EF4444;"></i> <span>${message}</span>`;
                container.appendChild(toast);
                setTimeout(() => {
                    toast.style.animation = 'fadeOut 0.3s ease-out forwards';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            function togglePlugin(action, enabled) {
                console.log('Toggling Plugin:', action, enabled);
                const guild_id = "<%= guild.id %>";

                fetch('/dashboard/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: action,
                        guild_id: guild_id,
                        enabled: enabled ? 1 : 0,
                        ajax: true
                    })
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        showToast('外掛狀態已更新', 'success');
                        setTimeout(() => location.reload(), 500); // Reload to show/hide config area
                    } else {
                        showToast('更新失敗: ' + data.message, 'error');
                    }
                }).catch(err => {
                    console.error('Toggle Error:', err);
                    showToast('網路錯誤', 'error');
                });
            }

            function openConfig(moduleId) {
                console.log('Opening Config for:', moduleId);
                const grid = document.getElementById('modules-grid');
                if (grid) grid.style.display = 'none';

                document.querySelectorAll('.config-section').forEach(el => el.classList.remove('active'));
                const target = document.getElementById('config-' + moduleId);
                if (target) {
                    target.classList.add('active');
                    const mainContent = document.querySelector('.main-content');
                    if (mainContent) mainContent.scrollTop = 0;
                    console.log('Config section activated:', moduleId);
                } else {
                    console.error('Config target not found:', 'config-' + moduleId);
                }
            }

            function closeConfig() {
                console.log('Closing Config');
                document.querySelectorAll('.config-section').forEach(el => el.classList.remove('active'));
                const grid = document.getElementById('modules-grid');
                if (grid) grid.style.display = 'grid';
            }

            document.addEventListener('DOMContentLoaded', () => {
                console.log('Settings Page Initialized');

                // --- Instant Toggle Logic (AJAX) ---
                document.querySelectorAll('.switch input[type="checkbox"]').forEach(toggle => {
                    toggle.addEventListener('change', async function () {
                        const form = this.closest('form');
                        const formData = new FormData(form);
                        const data = {};
                        formData.forEach((value, key) => data[key] = value);
                        data.ajax = true;

                        try {
                            const response = await fetch('/dashboard/settings', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify(data)
                            });

                            const result = await response.json();
                            if (result.success) {
                                showToast('設定已更新 (Updated)', 'success');
                                this.dataset.initial = this.checked;
                                if (window.checkDirty) window.checkDirty(this, form);
                            } else {
                                throw new Error(result.message);
                            }
                        } catch (err) {
                            console.error('AJAX Toggle Error:', err);
                            showToast('更新失敗: ' + err.message, 'error');
                            this.checked = !this.checked;
                        }
                    });
                });

                // --- Unsaved Changes Logic ---
                window.dirtyForms = new Set();
                const bar = document.getElementById('unsaved-bar');
                const btnSave = document.getElementById('btn-save');
                const btnReset = document.getElementById('btn-reset');

                window.checkDirty = function (input, form) {
                    let isDirty = false;
                    if (input.type === 'checkbox' || input.type === 'radio') {
                        isDirty = input.checked.toString() !== input.dataset.initial;
                    } else {
                        isDirty = input.value !== input.dataset.initial;
                    }

                    if (isDirty) {
                        window.dirtyForms.add(form);
                        form.classList.add('is-dirty');
                    } else {
                        let formActuallyDirty = false;
                        form.querySelectorAll('input, textarea, select').forEach(el => {
                            if (el.type === 'hidden' && !el.classList.contains('plugin-state')) return;
                            let d = false;
                            if (el.type === 'checkbox' || el.type === 'radio') {
                                d = el.checked.toString() !== el.dataset.initial;
                            } else {
                                d = el.value !== el.dataset.initial;
                            }
                            if (d) formActuallyDirty = true;
                        });

                        if (!formActuallyDirty) {
                            window.dirtyForms.delete(form);
                            form.classList.remove('is-dirty');
                        }
                    }

                    if (window.dirtyForms.size > 0) {
                        bar.classList.add('visible');
                    } else {
                        bar.classList.remove('visible');
                    }
                }

                document.querySelectorAll('form.track-changes').forEach(form => {
                    form.querySelectorAll('input, textarea, select').forEach(input => {
                        if (input.type === 'hidden' && !input.classList.contains('plugin-state')) return;
                        if (input.type === 'checkbox' || input.type === 'radio') {
                            input.dataset.initial = input.checked;
                        } else {
                            input.dataset.initial = input.value;
                        }
                        input.addEventListener('change', () => window.checkDirty(input, form));
                        input.addEventListener('input', () => window.checkDirty(input, form));
                    });
                });

                btnReset.addEventListener('click', () => {
                    if (confirm('確定要放棄所有變更嗎？')) location.reload();
                });

                btnSave.addEventListener('click', async () => {
                    if (window.dirtyForms.size === 0) return;
                    const originalText = btnSave.innerText;
                    btnSave.innerText = '儲存中... (Saving...)';
                    btnSave.disabled = true;

                    try {
                        const promises = [];
                        for (const form of window.dirtyForms) {
                            const actionUrl = form.getAttribute('action');
                            const formData = new FormData(form);
                            const params = new URLSearchParams(formData);
                            promises.push(fetch(actionUrl, {
                                method: 'POST',
                                body: params,
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                            }).then(async res => {
                                if (!res.ok) throw new Error(`Server returned ${res.status}`);
                                return res;
                            }));
                        }
                        await Promise.all(promises);
                        btnSave.innerText = '已儲存! (Saved!)';
                        btnSave.style.background = '#43b581';
                        setTimeout(() => location.reload(), 500);
                    } catch (error) {
                        console.error('Batch Save Error:', error);
                        btnSave.innerText = '失敗 (Failed)';
                        btnSave.style.background = '#f04747';
                        alert('儲存失敗：' + error.message);
                        setTimeout(() => {
                            btnSave.innerText = originalText;
                            btnSave.disabled = false;
                            btnSave.style.background = '';
                        }, 2000);
                    }
                });

                // --- URL Helper ---
                const urlParams = new URLSearchParams(window.location.search);
                const openModule = urlParams.get('open');
                if (openModule) openConfig(openModule);
            });
        </script>

        </div>
        <% } %>
            </div>
            </div>

            <!-- Unsaved Changes Floating Bar -->
            <div id="unsaved-bar" class="unsaved-bar">
                <span>小心！你有未儲存的變更 (You have unsaved changes)</span>
                <div style="display: flex; gap: 10px;">
                    <button id="btn-reset" type="button" class="btn-reset">重置 (Reset)</button>
                    <button id="btn-save" type="button" class="btn-save">儲存變更 (Save)</button>
                </div>
            </div>


            <%- include('partials/cookie_consent') %>
</body>

</html>