<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>錯誤 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
</head>

<body class="public-layout"
    style="display: flex; align-items: center; justify-content: center; height: 100vh; text-align: center;">
    <div class="glass-panel" style="padding: 4rem; max-width: 500px;">
        <i class="fa-solid fa-triangle-exclamation"
            style="font-size: 4rem; color: var(--danger-color); margin-bottom: 1.5rem;"></i>
        <h1 style="margin: 0; font-family: var(--font-heading);">發生錯誤 (Error)</h1>
        <p style="color: var(--text-secondary); margin: 1rem 0 2rem 0;">
            <%= error || '發生未知的內部錯誤' %>
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/" class="btn-submit"
                style="text-decoration: none; background: var(--bg-hover); border: 1px solid var(--border-color);">返回首頁</a>
            <a href="/auth/discord" class="btn-submit" style="text-decoration: none;">重新登入</a>
        </div>
    </div>
</body>

</html>