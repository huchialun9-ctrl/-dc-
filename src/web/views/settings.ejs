<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>控制台 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .role-row {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            align-items: center;
            background: rgba(0, 0, 0, 0.2);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .btn-remove {
            background: rgba(240, 71, 71, 0.2);
            color: #f04747;
            border: 1px solid rgba(240, 71, 71, 0.3);
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-remove:hover {
            background: rgba(240, 71, 71, 0.4);
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/settings' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>
                    <%= mode==='guild' ? `管理 ${guild.name}` : '全域設定' %>
                </h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <% if (mode==='global' ) { %>
                <!-- Global Settings -->
                <div class="card" style="max-width: 600px;">
                    <p style="color: var(--warning-color); margin-bottom: 2rem;">
                        <i class="fa-solid fa-triangle-exclamation"></i> 注意：這是機器人的全域設定。
                    </p>
                    <form action="/dashboard/settings" method="POST">
                        <input type="hidden" name="action" value="global_update">
                        <div class="form-group">
                            <label>機器人名稱</label>
                            <input type="text" value="VX6 System" disabled>
                        </div>
                        <button type="submit" class="btn-submit">儲存變更</button>
                    </form>
                </div>
                <% } else { %>
                    <!-- Guild Specific Modules -->
                    <div class="dashboard-grid">

                        <!-- Module 1: Announcement Builder -->
                        <div class="settings-card" style="border-top: 4px solid var(--accent-color);">
                            <div
                                style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                                <h3 style="margin:0;"><i class="fa-solid fa-bullhorn"
                                        style="color: var(--accent-color); margin-right: 10px;"></i> 發送公告</h3>
                            </div>

                            <form action="/dashboard/settings" method="POST"
                                style="flex: 1; display: flex; flex-direction: column;">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <input type="hidden" name="action" value="send_announcement">

                                <div class="form-group">
                                    <label>選擇頻道</label>
                                    <select name="channel_id" required>
                                        <% channels.forEach(channel=> { %>
                                            <option value="<%= channel.id %>"># <%= channel.name %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>公告標題</label>
                                    <input type="text" name="title" placeholder="例如：重大更新通知" required>
                                </div>

                                <div class="form-group" style="flex: 1;">
                                    <label>公告內容</label>
                                    <textarea name="description" rows="5"
                                        style="width:100%; height: 100%; min-height: 120px; padding:1rem; background:rgba(0,0,0,0.3); border:1px solid var(--border-color); border-radius:10px; color:#fff;"
                                        placeholder="支援 Markdown 語法..." required></textarea>
                                </div>

                                <div class="form-group">
                                    <label>顏色 (Hex)</label>
                                    <div style="display: flex; gap: 10px;">
                                        <input type="color" name="color" value="#5865F2"
                                            style="height: 50px; width: 60px; padding: 0.5rem; flex: none;">
                                        <input type="text" value="#5865F2" disabled style="flex: 1; opacity: 0.7;">
                                    </div>
                                </div>

                                <button type="submit" class="btn-submit" style="width:100%; margin-top: auto;">
                                    <i class="fa-solid fa-paper-plane"></i> 發送訊息
                                </button>
                            </form>
                        </div>

                        <!-- Module 3: Welcome System -->
                        <div class="settings-card" style="display: block; border-top: 4px solid #00ff9d;">
                            <div
                                style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                                <h3 style="margin:0;"><i class="fa-solid fa-door-open"
                                        style="color: #00ff9d; margin-right: 10px;"></i> 歡迎系統
                                </h3>
                            </div>

                            <form action="/dashboard/settings" method="POST"
                                style="height: calc(100% - 60px); display: flex; flex-direction: column;">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <input type="hidden" name="action" value="update_welcome">

                                <div class="form-group">
                                    <div
                                        style="background: rgba(0,255,157,0.1); padding: 1rem; border-radius: 8px; border: 1px solid rgba(0,255,157,0.2);">
                                        <label style="display:flex; align-items:center; cursor:pointer; margin: 0;">
                                            <input type="checkbox" name="welcome_enabled" value="1" <%=typeof settings
                                                !=='undefined' && settings && settings.welcome_enabled ? 'checked' : ''
                                                %>
                                            style="width:20px; height: 20px; margin-right:10px;">
                                            <span style="font-weight: bold; color: #00ff9d;">啟用歡迎訊息功能</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>發送頻道</label>
                                    <select name="welcome_channel_id">
                                        <option value="">-- 請選擇頻道 --</option>
                                        <% channels.forEach(channel=> { %>
                                            <option value="<%= channel.id %>" <%=typeof settings !=='undefined' &&
                                                settings && settings.welcome_channel_id===channel.id ? 'selected' : ''
                                                %>># <%= channel.name %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>

                                <div class="form-group" style="flex: 1;">
                                    <label>歡迎訊息內容</label>
                                    <textarea name="welcome_message" rows="6"
                                        style="width:100%; height: 100%; min-height: 120px; padding:1rem; background:rgba(0,0,0,0.3); border:1px solid var(--border-color); border-radius:10px; color:#fff;"
                                        placeholder="Welcome {user} to {server}! (支援變數: {user}, {server}, {memberCount})"><%= typeof settings !== 'undefined' && settings && settings.welcome_message ? settings.welcome_message : '' %></textarea>
                                    <small style="color: var(--text-secondary); display: block; margin-top: 5px;">
                                        可用變數: <code>{user}</code> (用戶), <code>{server}</code> (伺服器名),
                                        <code>{memberCount}</code> (人數)
                                    </small>
                                </div>

                                <button type="submit" class="btn-submit"
                                    style="background:var(--accent-color); width:100%; margin-top: auto;">
                                    <i class="fa-solid fa-save"></i> 儲存歡迎設定
                                </button>
                            </form>
                        </div>

                        <!-- Module 2: Role Claim (Enhanced) - Spans Full Width -->
                        <div class="settings-card"
                            style="grid-column: 1 / -1; border-top: 4px solid var(--warning-color);">
                            <div
                                style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                                <h3 style="margin:0;"><i class="fa-solid fa-user-tag"
                                        style="color: var(--warning-color); margin-right: 10px;"></i> 身分組領取面板</h3>
                                <span class="badge"
                                    style="background: rgba(250, 166, 26, 0.1); color: var(--warning-color);">Builder</span>
                            </div>

                            <form action="/dashboard/settings" method="POST" id="roleClaimForm">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <input type="hidden" name="action" value="create_role_claim">

                                <div
                                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                                    <div class="form-group" style="margin-bottom: 0;">
                                        <label>選擇發送頻道</label>
                                        <select name="channel_id" required>
                                            <% channels.forEach(channel=> { %>
                                                <option value="<%= channel.id %>"># <%= channel.name %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>

                                    <div class="form-group" style="margin-bottom: 0;">
                                        <label>面板標題</label>
                                        <input type="text" name="embed_title" value="身分組自助領取">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label style="margin-bottom: 1rem; display: block;">按鈕配置 (最多 15 個)</label>
                                    <div id="roleRows"
                                        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem;">
                                        <!-- Dynamic Rows will be inserted here -->
                                    </div>

                                    <div style="margin-top: 1.5rem; text-align: center;">
                                        <button type="button" class="btn-secondary" onclick="addRoleRow()"
                                            style="width: auto; padding: 0.8rem 2rem; border-style: dashed;">
                                            <i class="fa-solid fa-plus"></i> 新增一個身分組按鈕
                                        </button>
                                    </div>
                                </div>

                                <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 2rem 0;">

                                <button type="submit" class="btn-submit"
                                    style="background: var(--success-color); width:100%; font-size: 1.1rem;">
                                    <i class="fa-solid fa-hammer"></i> 建立並發送面板
                                </button>
                            </form>
                        </div>

                    </div>
                    <% } %>
        </div>

        <!-- Data for JS -->
        <!-- Data Injection for JS (clean separation to avoid Linter errors) -->
        <script id="server-data-roles" type="application/json"><%- JSON.stringify(roles || []) %></script>
        <script id="server-data-emojis" type="application/json"><%- JSON.stringify(emojis || []) %></script>
        <script id="server-data-mode" type="application/json"><%- JSON.stringify(mode) %></script>

        <script>
            // Read data from DOM
            const ROLES = JSON.parse(document.getElementById('server-data-roles').textContent);
            const EMOJIS = JSON.parse(document.getElementById('server-data-emojis').textContent);
            const MODE = JSON.parse(document.getElementById('server-data-mode').textContent);
            let rowCount = 0;

            function addRoleRow() {
                if (rowCount >= 15) return alert('最多只能新增 15 個按鈕！');

                const container = document.getElementById('roleRows');
                const div = document.createElement('div');
                div.className = 'role-row';
                div.id = `row-${rowCount}`;

                // Build Role Options
                let roleOptions = '<option value="">選擇身分組...</option>';
                ROLES.forEach(r => {
                    roleOptions += `<option value="${r.id}" style="color:${r.color}">${r.name}</option>`;
                });

                // Build Emoji Options
                let emojiOptions = '<option value="">無表情符號</option>';
                // Standard Emojis (Sample)
                const standardEmojis = ['🔥', '✨', '🎮', '📢', '💎', '✅', '❌', '⭐'];
                standardEmojis.forEach(e => {
                    emojiOptions += `<option value="${e}">${e}</option>`;
                });
                // Guild Emojis
                emojiOptions += '<optgroup label="伺服器表情符號">';
                EMOJIS.forEach(e => {
                    emojiOptions += `<option value="${e.identifier}" data-url="${e.url}">${e.name}</option>`;
                });
                emojiOptions += '</optgroup>';

                div.innerHTML = `
                <div style="flex: 1;">
                    <select name="roles[${rowCount}][role_id]" required style="margin-bottom: 0.5rem;">${roleOptions}</select>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input type="text" name="roles[${rowCount}][label]" placeholder="按鈕文字" required>
                        <select name="roles[${rowCount}][emoji]" style="width: 120px;" onchange="updateEmojiPreview(this)">${emojiOptions}</select>
                        <img class="emoji-preview" src="" style="width: 32px; height: 32px; display: none; object-fit: contain;">
                    </div>
                </div>
                <button type="button" class="btn-remove" onclick="removeRow(${rowCount})">
                    <i class="fa-solid fa-trash"></i>
                </button>
            `;

                container.appendChild(div);
                rowCount++;
            }

            function updateEmojiPreview(selectElement) {
                const selectedOption = selectElement.options[selectElement.selectedIndex];
                const url = selectedOption.getAttribute('data-url');
                const img = selectElement.nextElementSibling; // The img tag next to select

                if (url) {
                    img.src = url;
                    img.style.display = 'block';
                } else {
                    // Start of standard emoji handling? 
                    // Standard emojis don't have URLs easily available without a library.
                    // For now, hide preview if no URL.
                    img.style.display = 'none';
                    img.src = '';
                }
            }

            function removeRow(id) {
                const row = document.getElementById(`row-${id}`);
                if (row) row.remove();
            }

            // Init with 1 row if in guild mode
            if (MODE === 'guild') {
                addRoleRow();
            }
        </script>
</body>

</html>