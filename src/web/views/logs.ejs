<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>系統日誌 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/logs' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>系統審計日誌 (Audit Logs)</h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <div class="card"
                style="background: var(--bg-card); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color);">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>時間</th>
                            <th>使用者 ID</th>
                            <th>操作</th>
                            <th>詳細資訊</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% logs.forEach(log=> { %>
                            <tr>
                                <td>
                                    <%= new Date(log.created_at).toLocaleString('zh-TW') %>
                                </td>
                                <td>
                                    <%= log.user_id %>
                                </td>
                                <td><span class="status-badge status-open">
                                        <%= log.action %>
                                    </span></td>
                                <td>
                                    <%= log.details %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <%- include('partials/cookie_consent') %>
</body>

</html>