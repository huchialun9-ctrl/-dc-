<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>使用者管理 - VX6</title>
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/users' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>使用者管理</h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <div class="card"
                style="background: var(--bg-card); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color);">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>使用者</th>
                            <th>ID</th>
                            <th>最後登入</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% usersList.forEach(u=> { %>
                            <tr>
                                <td style="display:flex;align-items:center;gap:10px;">
                                    <% if(u.avatar) { %>
                                        <img src="https://cdn.discordapp.com/avatars/<%= u.id %>/<%= u.avatar %>.png"
                                            style="width:32px;height:32px;border-radius:50%;">
                                        <% } else { %>
                                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;">
                                            </div>
                                            <% } %>
                                                <%= u.username %>
                                </td>
                                <td>
                                    <%= u.id %>
                                </td>
                                <td>
                                    <%= new Date(u.last_login).toLocaleString('zh-TW') %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
</body>

</html>