<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>客服紀錄 - <%= guild.name %>
    </title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: var(--bg-body);
            color: var(--text-primary);
            font-family: 'Outfit', 'Noto Sans TC', sans-serif;
            margin: 0;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        .header {
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .transcript-list {
            display: grid;
            gap: 1rem;
        }

        .transcript-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .transcript-card:hover {
            background: rgba(255, 255, 255, 0.06);
            transform: translateX(5px);
        }

        .meta {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .btn-view {
            padding: 0.6rem 1.2rem;
            background: var(--accent-color);
            color: var(--text-primary);
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <div>
                <a href="/dashboard/settings?guild_id=<%= guild.id %>"
                    style="color: var(--text-secondary); text-decoration: none; margin-bottom: 0.5rem; display: block;">
                    <i class="fa-solid fa-arrow-left"></i> 返回控制台
                </a>
                <h1><i class="fa-solid fa-folder-open" style="color: #2ECC71;"></i> 客服紀錄庫</h1>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: bold;">
                    <%= guild.name %>
                </div>
                <div style="color: var(--text-secondary);">共 <%= transcripts.length %> 筆紀錄</div>
            </div>
        </div>

        <div class="transcript-list">
            <% if (transcripts.length===0) { %>
                <div
                    style="text-align: center; padding: 4rem; color: var(--text-secondary); background: rgba(0,0,0,0.2); border-radius: 12px;">
                    <i class="fa-solid fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                    <p>目前沒有已結案的客服紀錄。</p>
                </div>
                <% } %>

                    <% transcripts.forEach(t=> { %>
                        <div class="transcript-card">
                            <div>
                                <div style="font-weight: bold; font-size: 1.1rem; color: var(--text-primary);">
                                    #<%= t.channel_name %>
                                </div>
                                <div class="meta">
                                    <i class="fa-solid fa-user"></i> ID: <%= t.user_id %> |
                                        <i class="fa-solid fa-clock"></i>
                                        <%= new Date(t.closed_at).toLocaleString('zh-TW') %>
                                </div>
                            </div>
                            <a href="/dashboard/transcripts/<%= guild.id %>/<%= t.id %>" target="_blank"
                                class="btn-view">
                                <i class="fa-solid fa-eye"></i> 查看紀錄
                            </a>
                        </div>
                        <% }); %>
        </div>
    </div>
</body>

</html>