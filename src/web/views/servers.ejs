<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>選擇伺服器 - VX6</title>
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/servers' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>選擇伺服器</h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <div class="dashboard-grid">
                <% if (guilds && guilds.length> 0) { %>
                    <% guilds.forEach(guild=> { %>
                        <div class="stat-card"
                            style="flex-direction: column; align-items: center; text-align: center; gap: 1rem;">
                            <div class="stat-icon" style="background: transparent; width: 64px; height: 64px;">
                                <% if (guild.icon) { %>
                                    <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png"
                                        style="width: 64px; height: 64px; border-radius: 50%;">
                                    <% } else { %>
                                        <div
                                            style="width:64px;height:64px;background:#333;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">
                                            <%= guild.name.charAt(0) %>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="stat-info" style="width: 100%;">
                                <h4 style="font-size: 1.1rem; color: var(--text-primary); margin-bottom: 0.5rem;">
                                    <%= guild.name %>
                                </h4>
                                <% if ((guild.permissions & 0x8)===0x8 || (guild.permissions & 0x20)===0x20) { %>
                                    <a href="/dashboard/settings?guild_id=<%= guild.id %>" class="btn-submit"
                                        style="display:inline-block; text-decoration: none; font-size: 0.9rem; padding: 0.4rem 1rem;">管理</a>
                                    <% } else { %>
                                        <span style="font-size: 0.8rem; color: var(--text-secondary);">無管理權限</span>
                                        <% } %>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div
                                    style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--text-secondary);">
                                    <i class="fa-solid fa-ghost" style="font-size: 3rem; margin-bottom: 1rem;"></i>
                                    <p>找不到伺服器，或尚未授權讀取伺服器列表。</p>
                                    <a href="/auth/discord" style="color: var(--accent-color);">重新登入並授權</a>
                                </div>
                                <% } %>
            </div>
        </div>
</body>

</html>