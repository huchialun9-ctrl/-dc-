<div class="sidebar">
    <div class="sidebar-logo">
        <div
            style="width: 42px; height: 42px; background: var(--hero-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 16px rgba(99, 102, 241, 0.3);">
            <i class="fa-solid fa-bolt" style="color: white; font-size: 1.25rem;"></i>
        </div>
        <span class="text-gradient">VX6</span>
    </div>
    <nav class="sidebar-nav">
        <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">
            <i class="fa-solid fa-compass"></i>
            <%= t('sidebar.overview') %>
        </a>
        <a href="/dashboard/servers" class="<%= path === '/dashboard/servers' ? 'active' : '' %>">
            <i class="fa-solid fa-server"></i>
            <%= t('sidebar.servers') %>
        </a>
        <a href="/dashboard/broadcast" class="<%= path === '/dashboard/broadcast' ? 'active' : '' %>">
            <i class="fa-solid fa-bullhorn"></i>
            <%= t('sidebar.broadcast') %>
        </a>
        <a href="/dashboard/logs" class="<%= path === '/dashboard/logs' ? 'active' : '' %>">
            <i class="fa-solid fa-scroll"></i>
            <%= t('sidebar.logs') %>
        </a>
        <a href="/dashboard/settings" class="<%= path === '/dashboard/settings' ? 'active' : '' %>">
            <i class="fa-solid fa-sliders"></i>
            <%= t('sidebar.settings') %>
        </a>
        <a href="/docs" class="<%= path === '/docs' ? 'active' : '' %>">
            <i class="fa-solid fa-book-open"></i>
            <%= t('sidebar.docs') %>
        </a>

        <div style="flex-grow: 1;"></div>

        <div
            style="padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); margin-bottom: 2rem;">
            <p
                style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 1rem; letter-spacing: 0.05em;">
                Preferences</p>
            <div style="display: flex; gap: 1rem;">
                <button onclick="toggleTheme()" class="icon-btn" title="Toggle Theme">
                    <i class="fa-solid fa-moon" id="theme-icon"></i>
                </button>
                <button onclick="toggleLang()" class="icon-btn" title="Switch Language">
                    <i class="fa-solid fa-language"></i>
                </button>
            </div>
        </div>

        <a href="/auth/logout"
            style="color: var(--danger-color); background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.1);">
            <i class="fa-solid fa-power-off"></i>
            <%= t('sidebar.logout') %>
        </a>
    </nav>
</div>

<style>
    .icon-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        width: 36px;
        height: 36px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .icon-btn:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- Theme Logic ---
        const themeIcon = document.getElementById('theme-icon');
        const html = document.documentElement;

        // 1. Load saved theme
        const savedTheme = localStorage.getItem('theme') || 'dark';
        applyTheme(savedTheme);

        window.toggleTheme = function () {
            const current = html.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            applyTheme(next);
            localStorage.setItem('theme', next);
        };

        function applyTheme(theme) {
            if (theme === 'light') {
                html.setAttribute('data-theme', 'light');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                html.setAttribute('data-theme', 'dark'); // Explicitly set dark for clarity
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }

        // --- Language Logic ---
        window.toggleLang = function () {
            // Simple regex to get cookie
            const match = document.cookie.match(new RegExp('(^| )lang=([^;]+)'));
            const currentLang = match ? match[2] : 'zh';
            const newLang = currentLang === 'zh' ? 'en' : 'zh';

            // Set cookie (Max-Age: 1 year)
            document.cookie = `lang=${newLang}; path=/; max-age=31536000; SameSite=Lax`;

            // Reload to apply
            window.location.reload();
        };
    });
</script>