<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>控制台 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .plugin-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .plugin-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
            background: rgba(18, 18, 22, 0.85);
        }

        .plugin-info {
            padding: 1.5rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            margin-top: 1rem;
        }

        .config-btn-small {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-secondary);
            padding: 0.6rem 1.2rem;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            transition: all 0.3s;
        }

        .config-btn-small:hover {
            background: var(--accent-color);
            color: white;
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/settings' }) %>

        <div class="main-content">
            <!-- Dashboard Header -->
            <div class="topbar">
                <div class="topbar-left">
                    <h2 class="text-gradient" style="font-size: 2.2rem; font-weight: 900;">
                        <i class="fa-solid fa-sliders" style="margin-right: 1rem; opacity: 0.8; font-size: 1.8rem;"></i>
                        <%= mode==='guild' ? guild.name : '系統核心設定' %>
                    </h2>
                    <div
                        style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i class="fa-solid fa-circle-check" style="color: var(--success-color); font-size: 0.8rem;"></i>
                        控制台連線正常 (Connection Secure)
                    </div>
                </div>
                <div class="user-menu" style="padding: 0.6rem 1.5rem; border-radius: 20px;">
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar"
                            class="user-avatar"
                            style="width: 38px; height: 38px; border: 2px solid rgba(255,255,255,0.1);">
                        <% } else { %>
                            <div
                                style="width:38px;height:38px;background:var(--hero-gradient);border-radius:50%; border: 2px solid rgba(255,255,255,0.1);">
                            </div>
                            <% } %>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-weight: 800; font-size: 0.95rem;">
                                        <%= user.username %>
                                    </span>
                                    <span
                                        style="font-size: 0.75rem; color: var(--text-muted); opacity: 0.8;">管理員模式</span>
                                </div>
                </div>
            </div>

            <% if (mode==='global' ) { %>
                <!-- Global Settings Redesigned -->
                <div class="premium-card" style="max-width: 800px; margin-bottom: 4rem;">
                    <div class="card-header">
                        <div
                            style="width: 50px; height: 50px; background: rgba(251, 191, 36, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-microchip"
                                style="color: var(--warning-color); font-size: 1.5rem;"></i>
                        </div>
                        <div>
                            <h3 style="margin-bottom: 0.25rem;">全域核心設定 (Core Engine)</h3>
                            <p style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">控制 VX6 系統的底層運作參數
                            </p>
                        </div>
                    </div>
                    <form action="/dashboard/settings" method="POST" class="track-changes">
                        <input type="hidden" name="action" value="global_update">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                            <div class="form-group">
                                <label>系統實體名稱</label>
                                <input type="text" value="VX6 Multiverse System" class="modern-input" disabled
                                    style="opacity: 0.6; cursor: not-allowed;">
                            </div>
                            <div class="form-group">
                                <label>核心版本</label>
                                <input type="text" value="v2.4.0-premium" class="modern-input" disabled
                                    style="opacity: 0.6; cursor: not-allowed;">
                            </div>
                        </div>
                        <button type="submit" class="save-btn" style="margin-top: 1rem;">
                            <i class="fa-solid fa-shield-halved"></i> 授權並重新啟動核心
                        </button>
                    </form>
                </div>
                <% } else { %>
                    <!-- General Guild Settings Redesigned -->
                    <div class="premium-card"
                        style="margin-bottom: 4rem; background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);">
                        <div class="card-header">
                            <div
                                style="width: 50px; height: 50px; background: rgba(5, 182, 212, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-server"
                                    style="color: var(--accent-secondary); font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h3 style="margin-bottom: 0.25rem;">伺服器基本框架 (Basic Framework)</h3>
                                <p style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">配置伺服器的基本互動邏輯
                                </p>
                            </div>
                        </div>
                        <form action="/dashboard/settings" method="POST" class="track-changes"
                            style="display: flex; gap: 2.5rem; align-items: flex-end; flex-wrap: wrap;">
                            <input type="hidden" name="action" value="update_language">
                            <input type="hidden" name="guild_id" value="<%= guild.id %>">
                            <div class="form-group" style="flex: 1; min-width: 300px; margin-bottom: 0;">
                                <label>偏好語系 (Interaction Language)</label>
                                <select name="language" class="modern-input" required>
                                    <option value="zh" <%=settings.language==='zh' ? 'selected' : '' %>>繁體中文 (Taiwan) -
                                        精準翻譯</option>
                                    <option value="en" <%=settings.language==='en' ? 'selected' : '' %>>English
                                        (Universal) - Original</option>
                                </select>
                            </div>
                            <button type="submit" class="save-btn" style="height: 54px;">
                                <i class="fa-solid fa-square-check"></i> 同步基本資料
                            </button>
                        </form>
                    </div>

                    <!-- Plugin Grid -->
                    <div id="modules-grid" class="dashboard-grid">

                        <!-- 1. Announcement Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="announcement">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(244, 63, 94, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-bullhorn" style="color: #f43f5e; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">廣播與公告系統</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                向特定頻道發送精美的崁入式公告訊息，支援多種格式。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.announcement_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.announcement_enabled ? 'fa-check-circle' : 'fa-circle-dot' %>"></i>
                                    <%= settings.announcement_enabled ? '運作中' : '已暫停' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="announcement_enabled" <%=settings.announcement_enabled
                                        ? 'checked' : '' %>
                                    onchange="togglePlugin('announcement_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <% if (settings.announcement_enabled) { %>
                                <div class="plugin-info"
                                    style="border: 1px solid rgba(255,255,255,0.05); padding: 1.25rem; border-radius: 16px; background: rgba(0,0,0,0.2);">
                                    <h4
                                        style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1rem; letter-spacing: 0.05em;">
                                        快速廣播器 (Quick Sender)</h4>
                                    <form action="/dashboard/settings" method="POST">
                                        <input type="hidden" name="action" value="send_announcement">
                                        <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                        <div class="form-group" style="margin-bottom: 1rem;">
                                            <select name="announcement_channel_id" class="modern-input"
                                                style="padding: 0.75rem 1rem; font-size: 0.9rem;">
                                                <option value="" disabled selected>選擇公告頻道...</option>
                                                <% channels.forEach(c=> { %>
                                                    <option value="<%= c.id %>"># <%= c.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div class="form-group" style="margin-bottom: 1rem;">
                                            <textarea name="announcement_message" rows="2" class="modern-input"
                                                placeholder="輸入公告內容..."
                                                style="padding: 0.75rem 1rem; font-size: 0.9rem; resize: none;"></textarea>
                                        </div>
                                        <button type="submit" class="save-btn"
                                            style="width: 100%; border-radius: 12px; height: 44px; padding: 0; justify-content: center; font-size: 0.9rem;">
                                            <i class="fa-solid fa-paper-plane"></i> 立即發送公告
                                        </button>
                                    </form>
                                </div>
                                <% } %>
                                    <div class="card-watermark"><i class="fa-solid fa-bullhorn"></i></div>
                        </div>

                        <!-- 2. Welcome Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="welcome">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(99, 102, 241, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-door-open" style="color: #6366f1; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">自動歡迎系統</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                當新成員加入時發送溫暖的歡迎訊息，提供絕佳入群體驗。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.welcome_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.welcome_enabled ? 'fa-bolt' : 'fa-circle-dot' %>"></i>
                                    <%= settings.welcome_enabled ? '監控中' : '已停用' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="welcome_enabled" <%=settings.welcome_enabled
                                        ? 'checked' : '' %>
                                    onchange="togglePlugin('welcome_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <% if (settings.welcome_enabled) { %>
                                <div class="plugin-info"
                                    style="border: 1px solid rgba(255,255,255,0.05); padding: 1.25rem; border-radius: 16px; background: rgba(0,0,0,0.2);">
                                    <form action="/dashboard/settings" method="POST" class="track-changes">
                                        <input type="hidden" name="action" value="update_welcome">
                                        <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                        <div class="form-group" style="margin-bottom: 1rem;">
                                            <label
                                                style="font-size: 0.75rem; color: var(--text-muted); opacity: 0.7;">歡迎頻道
                                                (Target Channel)</label>
                                            <select name="welcome_channel_id" class="modern-input"
                                                style="padding: 0.75rem 1rem; font-size: 0.9rem;">
                                                <% channels.forEach(c=> { %>
                                                    <option value="<%= c.id %>" <%=settings.welcome_channel_id===c.id
                                                        ? 'selected' : '' %>># <%= c.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div class="form-group" style="margin-bottom: 1rem;">
                                            <label
                                                style="font-size: 0.75rem; color: var(--text-muted); opacity: 0.7;">歡迎訊息
                                                (Custom Message)</label>
                                            <textarea name="welcome_message" rows="2" class="modern-input"
                                                style="padding: 0.75rem 1rem; font-size: 0.9rem; resize: none;"><%= settings.welcome_message %></textarea>
                                        </div>
                                        <button type="submit" class="config-btn-small"
                                            style="width: 100%; justify-content: center; height: 44px; border-radius: 12px;">
                                            <i class="fa-solid fa-save"></i> 儲存設定
                                        </button>
                                    </form>
                                </div>
                                <% } %>
                                    <div class="card-watermark"><i class="fa-solid fa-door-open"></i></div>
                        </div>

                        <!-- 3. Economy Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="economy">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(251, 191, 36, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-coins" style="color: #fbbf24; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">經濟與貨幣系統</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                管理伺服器的虛擬經濟，包含錢包、簽到、轉帳與排行榜功能。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.economy_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.economy_enabled ? 'fa-wallet' : 'fa-circle-dot' %>"></i>
                                    <%= settings.economy_enabled ? '已連線' : '離線中' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="economy_enabled" <%=settings.economy_enabled
                                        ? 'checked' : '' %>
                                    onchange="togglePlugin('economy_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <button type="button" class="config-btn-small" onclick="openConfig('economy')"
                                style="width: 100%; justify-content: center; height: 44px; border-radius: 12px;">
                                <i class="fa-solid fa-sliders"></i> 進階參數配置
                            </button>
                            <div class="card-watermark"><i class="fa-solid fa-coins"></i></div>
                        </div>

                        <!-- 4. AI Chat Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="ai">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(167, 139, 250, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-wand-magic-sparkles"
                                        style="color: #a78bfa; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">AI 智慧對應系統</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                讓機器人具備智慧對答能力，支援脈絡理解與多語言互動。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.ai_chat_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.ai_chat_enabled ? 'fa-brain' : 'fa-circle-dot' %>"></i>
                                    <%= settings.ai_chat_enabled ? '神經網路啟動' : '休眠中' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="ai_chat_enabled" <%=settings.ai_chat_enabled
                                        ? 'checked' : '' %>
                                    onchange="togglePlugin('ai_chat_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <button type="button" class="config-btn-small" onclick="openConfig('ai')"
                                style="width: 100%; justify-content: center; height: 44px; border-radius: 12px;">
                                <i class="fa-solid fa-brain"></i> 訓練與頻道配置
                            </button>
                            <div class="card-watermark"><i class="fa-solid fa-robot"></i></div>
                        </div>

                        <!-- 5. AutoMod Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="automod">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(52, 211, 153, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-shield-halved"
                                        style="color: #34d399; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">全自動核准審議</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                即時過濾非法連結、暴力詞彙與重複洗版。維護伺服器純淨環境。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.automod_links ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.automod_links ? 'fa-user-shield' : 'fa-circle-dot' %>"></i>
                                    <%= settings.automod_links ? '防護層啟動' : '防護層關閉' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="automod_links" <%=settings.automod_links ? 'checked'
                                        : '' %>
                                    onchange="togglePlugin('automod_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <button type="button" class="config-btn-small" onclick="openConfig('automod')"
                                style="width: 100%; justify-content: center; height: 44px; border-radius: 12px;">
                                <i class="fa-solid fa-filter"></i> 管理規則與黑名單
                            </button>
                            <div class="card-watermark"><i class="fa-solid fa-shield-halved"></i></div>
                        </div>

                        <!-- 6. Music Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="music">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(251, 146, 60, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-music" style="color: #fb923c; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">高效能串流音樂</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                高音質語音串流，支援 YouTube、Spotify 等來源。內建網頁控制器。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.music_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.music_enabled ? 'fa-headphones' : 'fa-circle-dot' %>"></i>
                                    <%= settings.music_enabled ? '串流引擎就緒' : '串流引擎關閉' %>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" name="music_enabled" <%=settings.music_enabled ? 'checked'
                                        : '' %>
                                    onchange="togglePlugin('music_toggle', this.checked)">
                                    <span class="slider round"></span>
                                </label>
                            </div>

                            <button type="button" class="config-btn-small" onclick="openConfig('music')"
                                style="width: 100%; justify-content: center; height: 44px; border-radius: 12px;">
                                <i class="fa-solid fa-compact-disc"></i> 控制器與音質
                            </button>
                            <div class="card-watermark"><i class="fa-solid fa-music"></i></div>
                        </div>

                        <!-- 7. Leveling Plugin Redesigned -->
                        <div class="premium-card plugin-card" data-module="leveling">
                            <div class="card-header">
                                <div
                                    style="width: 44px; height: 44px; background: rgba(244, 114, 182, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa-solid fa-chart-line" style="color: #f472b6; font-size: 1.25rem;"></i>
                                </div>
                                <h3 style="font-size: 1.25rem;">社交等級與經驗</h3>
                            </div>
                            <p
                                style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; line-height: 1.6;">
                                基於互動頻率的升級系統，追蹤活躍度並提供等級排行榜。</p>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                <div
                                    class="status-badge <%= settings.leveling_enabled ? 'status-enabled' : 'status-disabled' %>">
                                    <i
                                        class="fa-solid <%= settings.leveling_enabled ? 'fa-medal' : 'fa-circle-dot' %>"></i>
                                    <%= settings.leveling_enabled ? '數據追蹤中' : '數據暫停' %>
                                </div>
