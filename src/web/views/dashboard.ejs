<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>儀表板 - VX6</title>
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>系統總覽</h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>系統狀態</h4>
                        <div class="stat-value" style="color: var(--success-color, #43b581);">正常運作</div>
                    </div>
                    <div class="stat-icon"><i class="fa-solid fa-server"></i></div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h4>所在伺服器數</h4>
                        <div class="stat-value">
                            <%= stats.guilds %>
                        </div>
                    </div>
                    <div class="stat-icon"><i class="fa-solid fa-shield-cat"></i></div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h4>未結案工單</h4>
                        <div class="stat-value">
                            <%= stats.tickets %>
                        </div>
                    </div>
                    <div class="stat-icon"><i class="fa-solid fa-ticket"></i></div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h4>運行時間</h4>
                        <div class="stat-value">
                            <%= Math.floor(stats.uptime / 60) %> 分鐘
                        </div>
                    </div>
                    <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
                </div>
            </div>

            <div class="chart-container">
                <h3>工單量趨勢 (最近 7 天)</h3>
                <canvas id="ticketChart"></canvas>
            </div>
        </div>

        <script>
            const ctx = document.getElementById('ticketChart').getContext('2d');
            const ticketChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['週一', '週二', '週三', '週四', '週五', '週六', '週日'],
                    datasets: [{
                        label: '新增工單',
                        data: [12, 19, 3, 5, 2, 3, 15],
                        backgroundColor: 'rgba(88, 101, 242, 0.2)',
                        borderColor: 'rgba(88, 101, 242, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#222' }, ticks: { color: '#888' } },
                        x: { grid: { color: 'transparent' }, ticks: { color: '#888' } }
                    },
                    plugins: { legend: { labels: { color: '#fff' } } }
                }
            });
        </script>
</body>

</html>