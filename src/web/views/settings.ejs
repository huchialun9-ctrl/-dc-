<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>控制台 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .role-row {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            align-items: center;
            background: rgba(0, 0, 0, 0.2);
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .btn-remove {
            background: rgba(240, 71, 71, 0.2);
            color: #f04747;
            border: 1px solid rgba(240, 71, 71, 0.3);
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-remove:hover {
            background: rgba(240, 71, 71, 0.4);
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/settings' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>
                    <%= mode==='guild' ? `管理 ${guild.name}` : '全域設定' %>
                </h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <% if (mode==='global' ) { %>
                <!-- Global Settings -->
                <div class="card" style="max-width: 600px;">
                    <p style="color: var(--warning-color); margin-bottom: 2rem;">
                        <i class="fa-solid fa-triangle-exclamation"></i> 注意：這是機器人的全域設定。
                    </p>
                    <form action="/dashboard/settings" method="POST">
                        <input type="hidden" name="action" value="global_update">
                        <div class="form-group">
                            <label>機器人名稱</label>
                            <input type="text" value="VX6 System" disabled>
                        </div>
                        <button type="submit" class="btn-submit">儲存變更</button>
                    </form>
                </div>
                <% } else { %>
                    <!-- 1. Module Grid (Overview) -->
                    <div id="modules-grid" class="dashboard-grid">

                        <!-- Announcement (Tool) -->
                        <div class="settings-card">
                            <div class="card-header-content">
                                <div class="card-title">
                                    <i class="fa-solid fa-bullhorn" style="color: #F87171;"></i> 公告系統
                                </div>
                                <p class="card-desc">發送崁入式公告訊息到指定頻道。</p>
                            </div>
                            <div class="card-controls">
                                <button class="btn-setting" onclick="openConfig('announcement')">
                                    <i class="fa-solid fa-gear"></i> 開啟發送器
                                </button>
                            </div>
                            <div class="card-watermark">
                                <i class="fa-solid fa-bullhorn"></i>
                            </div>
                        </div>

                        <!-- Welcome (Toggle + Config) -->
                        <div class="settings-card">
                            <form action="/dashboard/settings" method="POST" class="track-changes"
                                style="height: 100%; display: flex; flex-direction: column;">
                                <input type="hidden" name="action" value="update_welcome_toggle">
                                <!-- Dummy action, handled by save -->
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                <div class="card-header-content">
                                    <div class="card-title">
                                        <i class="fa-solid fa-door-open" style="color: #60A5FA;"></i> 歡迎系統
                                    </div>
                                    <p class="card-desc">新成員加入時發送歡迎訊息。</p>
                                </div>
                                <div class="card-controls">
                                    <!-- Toggle -->
                                    <div class="form-check form-switch" style="margin-right: auto;">
                                        <input class="form-check-input detect-change module-toggle" type="checkbox"
                                            name="welcome_enabled" value="1" <%=settings.welcome_enabled ? 'checked'
                                            : '' %> data-target="btn-welcome">
                                    </div>
                                    <!-- Settings Button -->
                                    <button type="button" id="btn-welcome" class="btn-setting"
                                        onclick="openConfig('welcome')" <%=settings.welcome_enabled ? '' : 'disabled' %>
                                        style="<%= settings.welcome_enabled ? '' : 'opacity: 0.5; cursor: not-allowed;'
                                            %>">
                                            <i class="fa-solid fa-gear"></i> 設定
                                    </button>
                                </div>
                            </form>
                            <div class="card-watermark">
                                <i class="fa-solid fa-door-open"></i>
                            </div>
                        </div>

                        <!-- Economy (Toggle) -->
                        <div class="settings-card">
                            <form action="/dashboard/settings" method="POST" class="track-changes"
                                style="height: 100%; display: flex; flex-direction: column;">
                                <input type="hidden" name="action" value="update_economy">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                <div class="card-header-content">
                                    <div class="card-title">
                                        <i class="fa-solid fa-coins" style="color: #FBBF24;"></i> 經濟系統
                                    </div>
                                    <p class="card-desc">簽到、錢包與商店功能。</p>
                                </div>
                                <div class="card-controls">
                                    <div class="form-check form-switch" style="margin-right: auto;">
                                        <input class="form-check-input detect-change" type="checkbox"
                                            name="economy_enabled" value="1" <%=settings.economy_enabled ? 'checked'
                                            : '' %>>
                                    </div>
                                    <a href="/dashboard/leaderboard/<%= guild.id %>/economy" class="btn-setting">
                                        榜單
                                    </a>
                                </div>
                            </form>
                            <div class="card-watermark">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                        </div>

                        <!-- AI Chat (Toggle) -->
                        <div class="settings-card">
                            <form action="/dashboard/settings" method="POST" class="track-changes"
                                style="height: 100%; display: flex; flex-direction: column;">
                                <input type="hidden" name="action" value="update_ai_chat">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <div class="card-header-content">
                                    <div class="card-title">
                                        <i class="fa-solid fa-wand-magic-sparkles" style="color: #A78BFA;"></i> AI 聊天
                                    </div>
                                    <p class="card-desc">提及機器人即可對話。</p>
                                </div>
                                <div class="card-controls">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input detect-change" type="checkbox"
                                            name="ai_chat_enabled" value="1" <%=settings.ai_chat_enabled ? 'checked'
                                            : '' %>>
                                    </div>
                                </div>
                            </form>
                            <div class="card-watermark">
                                <i class="fa-solid fa-robot"></i>
                            </div>
                        </div>

                        <!-- AutoMod (Toggle + Config) -->
                        <div class="settings-card">
                            <form action="/dashboard/settings" method="POST" class="track-changes"
                                style="height: 100%; display: flex; flex-direction: column;">
                                <input type="hidden" name="action" value="update_automod_toggle">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <div class="card-header-content">
                                    <div class="card-title">
                                        <i class="fa-solid fa-shield-halved" style="color: #34D399;"></i> 自動審核
                                    </div>
                                    <p class="card-desc">過濾惡意連結與詞彙。</p>
                                </div>
                                <div class="card-controls">
                                    <div class="form-check form-switch" style="margin-right: auto;">
                                        <input class="form-check-input detect-change module-toggle" type="checkbox"
                                            name="automod_links" value="1" <%=settings.automod_links ? 'checked' : '' %>
                                        data-target="btn-automod">
                                    </div>
                                    <button type="button" id="btn-automod" class="btn-setting"
                                        onclick="openConfig('automod')" <%=settings.automod_links ? '' : 'disabled' %>
                                        style="<%= settings.automod_links ? '' : 'opacity: 0.5; cursor: not-allowed;' %>
                                            ">
                                            <i class="fa-solid fa-gear"></i> 設定
                                    </button>
                                </div>
                            </form>
                            <div class="card-watermark">
                                <i class="fa-solid fa-gavel"></i>
                            </div>
                        </div>

                        <!-- Music (External Link) -->
                        <div class="settings-card">
                            <div class="card-header-content">
                                <div class="card-title">
                                    <i class="fa-solid fa-music" style="color: #FB923C;"></i> 音樂播放器
                                </div>
                                <p class="card-desc">Web 音樂控制面板。</p>
                            </div>
                            <div class="card-controls">
                                <a href="/dashboard/music/<%= guild.id %>" class="btn-setting">
                                    開啟面板
                                </a>
                            </div>
                            <div class="card-watermark">
                                <i class="fa-solid fa-music"></i>
                            </div>
                        </div>

                        <!-- Leveling (Toggle) -->
                        <div class="settings-card">
                            <form action="/dashboard/settings" method="POST" class="track-changes"
                                style="height: 100%; display: flex; flex-direction: column;">
                                <input type="hidden" name="action" value="update_leveling">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <div class="card-header-content">
                                    <div class="card-title">
                                        <i class="fa-solid fa-chart-line" style="color: #F472B6;"></i> 等級系統
                                    </div>
                                    <p class="card-desc">聊天獲取經驗。</p>
                                </div>
                                <div class="card-controls">
                                    <div class="form-check form-switch" style="margin-right: auto;">
                                        <input class="form-check-input detect-change" type="checkbox"
                                            name="leveling_enabled" value="1" <%=settings.leveling_enabled ? 'checked'
                                            : '' %>>
                                    </div>
                                    <a href="/dashboard/leaderboard/<%= guild.id %>" class="btn-setting">
                                        排行榜
                                    </a>
                                </div>
                            </form>
                            <div class="card-watermark">
                                <i class="fa-solid fa-star"></i>
                            </div>
                        </div>

                        <!-- Custom Commands (Tool) -->
                        <div class="settings-card">
                            <div class="card-header-content">
                                <div class="card-title">
                                    <i class="fa-solid fa-terminal" style="color: #2DD4BF;"></i> 自訂指令
                                </div>
                                <p class="card-desc">管理伺服器專屬指令。</p>
                            </div>
                            <div class="card-controls">
                                <button class="btn-setting" onclick="openConfig('commands')">
                                    <i class="fa-solid fa-list-check"></i> 管理指令
                                </button>
                            </div>
                            <div class="card-watermark">
                                <i class="fa-solid fa-terminal"></i>
                            </div>
                        </div>

                    </div> <!-- End Grid -->

                    <!-- 2. Detailed Configuration Sections (Hidden by default) -->
                    <div id="modules-config">

                        <!-- Announcement Config -->
                        <div id="config-announcement" class="config-section">
                            <div class="config-header">
                                <button class="btn-back" onclick="closeConfig()">
                                    <i class="fa-solid fa-arrow-left"></i> 返回模組列表
                                </button>
                                <h3><i class="fa-solid fa-bullhorn" style="color: #F87171;"></i> 發送公告</h3>
                            </div>
                            <form action="/dashboard/settings" method="POST">
                                <input type="hidden" name="action" value="send_announcement">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                <div class="form-group">
                                    <label>選擇頻道</label>
                                    <select name="channel_id" class="form-control" required>
                                        <% channels.forEach(c=> { %>
                                            <option value="<%= c.id %>">#<%= c.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>標題</label>
                                    <input type="text" name="title" class="form-control" placeholder="公告標題" required>
                                </div>
                                <div class="form-group">
                                    <label>內容 (Markdown)</label>
                                    <textarea name="description" class="form-control" rows="6" placeholder="輸入公告內容..."
                                        required></textarea>
                                </div>
                                <div class="form-group">
                                    <label>顏色</label>
                                    <input type="color" name="color" value="#5865F2"
                                        style="width: 100%; height: 40px; border:none; border-radius: 4px;">
                                </div>
                                <button type="submit" class="btn-setting"
                                    style="width: 100%; padding: 1rem; margin-top: 1rem;">
                                    <i class="fa-solid fa-paper-plane"></i> 發送公告
                                </button>
                            </form>
                        </div>

                        <!-- Welcome Config -->
                        <div id="config-welcome" class="config-section">
                            <div class="config-header">
                                <button class="btn-back" onclick="closeConfig()">
                                    <i class="fa-solid fa-arrow-left"></i> 返回模組列表
                                </button>
                                <h3><i class="fa-solid fa-door-open" style="color: #60A5FA;"></i> 歡迎系統設定</h3>
                            </div>
                            <form action="/dashboard/settings" method="POST" class="track-changes">
                                <input type="hidden" name="action" value="update_welcome">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                <!-- Re-include toggle hidden state to ensure value persistence or rely on grid? 
                              Grid forms track changes independently. This form tracks detail settings.
                              The DB update usually updates ALL columns passed.
                              If I submit this form, it might miss 'welcome_enabled' if it's not here.
                              Actually, the backend update logic might handle partials or I should include a hidden input for enabled state?
                              Better: Include the toggle here too, synced?
                              Or just update the fields available.
                              Let's assume backend updates only fields present (except checkboxes which assume false if missing).
                              Safest is to separate actions or include all fields.
                              For now, I'll allow this form to update channel/message.
                          -->
                                <div class="form-group">
                                    <label>歡迎頻道</label>
                                    <select name="welcome_channel_id" class="form-control detect-change">
                                        <option value="">選擇頻道...</option>
                                        <% channels.forEach(c=> { %>
                                            <option value="<%= c.id %>" <%=settings.welcome_channel_id===c.id
                                                ? 'selected' : '' %>>#<%= c.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>歡迎訊息</label>
                                    <textarea name="welcome_message" class="form-control detect-change" rows="4"
                                        placeholder="歡迎 {user} 加入 {server}！"><%= settings.welcome_message %></textarea>
                                    <small style="color: var(--text-secondary);">可用變數: <code>{user}</code>,
                                        <code>{server}</code></small>
                                </div>
                            </form>
                        </div>

                        <!-- AutoMod Config -->
                        <div id="config-automod" class="config-section">
                            <div class="config-header">
                                <button class="btn-back" onclick="closeConfig()">
                                    <i class="fa-solid fa-arrow-left"></i> 返回模組列表
                                </button>
                                <h3><i class="fa-solid fa-shield-halved" style="color: #34D399;"></i> 自動審核設定</h3>
                            </div>
                            <form action="/dashboard/settings" method="POST" class="track-changes">
                                <input type="hidden" name="action" value="update_automod">
                                <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                <div class="form-group">
                                    <label>禁止詞彙 (Bad Words)</label>
                                    <input type="text" name="automod_badwords" class="form-control detect-change"
                                        value="<%= settings.automod_badwords %>" placeholder="垃圾, 廣告 (用逗號分隔)">
                                    <small style="color: var(--text-secondary);">包含這些詞彙的訊息將被自動刪除。</small>
                                </div>
                            </form>
                        </div>

                        <!-- Custom Commands Config -->
                        <div id="config-commands" class="config-section">
                            <div class="config-header">
                                <button class="btn-back" onclick="closeConfig()">
                                    <i class="fa-solid fa-arrow-left"></i> 返回模組列表
                                </button>
                                <h3><i class="fa-solid fa-terminal" style="color: #2DD4BF;"></i> 自訂指令管理</h3>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                                <div>
                                    <h4>新增指令</h4>
                                    <form action="/dashboard/settings" method="POST"
                                        style="background: rgba(0,0,0,0.2); padding: 1.5rem; border-radius: 12px;">
                                        <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                        <input type="hidden" name="action" value="add_command">
                                        <div class="form-group">
                                            <label>觸發詞</label>
                                            <input type="text" name="trigger" class="form-control" placeholder="!hello"
                                                required>
                                        </div>
                                        <div class="form-group">
                                            <label>回應</label>
                                            <textarea name="response" class="form-control" rows="3" required></textarea>
                                        </div>
                                        <button type="submit" class="btn-setting" style="width: 100%;">新增</button>
                                    </form>
                                </div>
                                <div>
                                    <h4>現有指令</h4>
                                    <div style="max-height: 400px; overflow-y: auto;">
                                        <% customCommands.forEach(cmd=> { %>
                                            <div
                                                style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; margin-bottom: 0.5rem;">
                                                <div>
                                                    <strong style="color: var(--accent-color);">
                                                        <%= cmd.trigger %>
                                                    </strong>
                                                    <p
                                                        style="margin: 0; color: var(--text-secondary); font-size: 0.9rem;">
                                                        <%= cmd.response %>
                                                    </p>
                                                </div>
                                                <form action="/dashboard/settings" method="POST" style="margin: 0;">
                                                    <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                                    <input type="hidden" name="action" value="delete_command">
                                                    <input type="hidden" name="command_id" value="<%= cmd.id %>">
                                                    <button type="submit" class="btn-remove"><i
                                                            class="fa-solid fa-trash"></i></button>
                                                </form>
                                            </div>
                                            <% }) %>
                                                <% if (customCommands.length===0) { %>
                                                    <p style="color: var(--text-muted); text-align: center;">無指令</p>
                                                    <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <script>
                        // Interactive Module Logic
                        document.addEventListener('DOMContentLoaded', () => {
                            const toggles = document.querySelectorAll('.module-toggle');
                            toggles.forEach(toggle => {
                                toggle.addEventListener('change', (e) => {
                                    const targetId = e.target.dataset.target;
                                    if (targetId) {
                                        const btn = document.getElementById(targetId);
                                        if (btn) {
                                            if (e.target.checked) {
                                                btn.disabled = false;
                                                btn.style.opacity = '1';
                                                btn.style.cursor = 'pointer';
                                            } else {
                                                btn.disabled = true;
                                                btn.style.opacity = '0.5';
                                                btn.style.cursor = 'not-allowed';
                                            }
                                        }
                                    }
                                    // Trigger save bar
                                });
                            });
                        });

                        function openConfig(moduleId) {
                            document.getElementById('modules-grid').style.display = 'none';
                            document.querySelectorAll('.config-section').forEach(el => el.classList.remove('active'));
                            const target = document.getElementById('config-' + moduleId);
                            if (target) {
                                target.classList.add('active');
                                // Scroll top
                                document.querySelector('.main-content').scrollTop = 0;
                            }
                        }

                        function closeConfig() {
                            document.querySelectorAll('.config-section').forEach(el => el.classList.remove('active'));
                            document.getElementById('modules-grid').style.display = 'grid'; // Restore grid
                        }
                    </script>

        </div>
        <% } %>
            </div>
            </div>

            <!-- Unsaved Changes Floating Bar -->
            <div id="unsaved-bar" class="unsaved-bar">
                <span>小心！你有未儲存的變更 (You have unsaved changes)</span>
                <div style="display: flex; gap: 10px;">
                    <button id="btn-reset" type="button" class="btn-reset">重置 (Reset)</button>
                    <button id="btn-save" type="button" class="btn-save">儲存變更 (Save)</button>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    let dirtyForms = new Set();
                    const bar = document.getElementById('unsaved-bar');
                    const btnSave = document.getElementById('btn-save');
                    const btnReset = document.getElementById('btn-reset');

                    // Initialize tracking
                    document.querySelectorAll('form.track-changes').forEach(form => {
                        form.querySelectorAll('input, textarea, select').forEach(input => {
                            if (input.type === 'hidden') return;

                            if (input.type === 'checkbox' || input.type === 'radio') {
                                input.dataset.initial = input.checked;
                            } else {
                                input.dataset.initial = input.value;
                            }

                            input.addEventListener('change', () => checkDirty(input, form));
                            input.addEventListener('input', () => checkDirty(input, form));
                        });
                    });

                    function checkDirty(input, form) {
                        let isDirty = false;
                        if (input.type === 'checkbox' || input.type === 'radio') {
                            isDirty = input.checked.toString() !== input.dataset.initial;
                        } else {
                            isDirty = input.value !== input.dataset.initial;
                        }

                        if (isDirty) {
                            dirtyForms.add(form);
                            form.classList.add('is-dirty');
                        } else {
                            let formActuallyDirty = false;
                            form.querySelectorAll('input, textarea, select').forEach(el => {
                                if (el.type === 'hidden') return;
                                let d = false;
                                if (el.type === 'checkbox' || el.type === 'radio') {
                                    d = el.checked.toString() !== el.dataset.initial;
                                } else {
                                    d = el.value !== el.dataset.initial;
                                }
                                if (d) formActuallyDirty = true;
                            });

                            if (!formActuallyDirty) {
                                dirtyForms.delete(form);
                                form.classList.remove('is-dirty');
                            }
                        }

                        if (dirtyForms.size > 0) {
                            bar.classList.add('visible');
                        } else {
                            bar.classList.remove('visible');
                        }
                    }

                    btnReset.addEventListener('click', () => {
                        if (confirm('確定要放棄所有變更嗎？')) {
                            location.reload();
                        }
                    });

                    btnSave.addEventListener('click', async () => {
                        console.log('Save button clicked (EventListener)');

                        if (dirtyForms.size === 0) {
                            console.warn('No dirty forms found');
                            alert('沒有偵測到變更 (No changes detected)');
                            return;
                        }

                        const originalText = btnSave.innerText;
                        btnSave.innerText = '儲存中... (Saving...)';
                        btnSave.disabled = true;

                        try {
                            const promises = [];
                            for (const form of dirtyForms) {
                                const actionUrl = form.getAttribute('action');
                                console.log('Submitting form:', actionUrl);
                                const formData = new FormData(form);
                                // Fix for checkboxes: FormData only declares them if checked.
                                // If unchecked, they are missing. Express needs them to be false/0 or handled.
                                // Our form logic uses value="1". If unchecked, it's missing.
                                // Backend: const { economy_enabled } = req.body; const enabled = economy_enabled ? 1 : 0;
                                // This works fine for x-www-form-urlencoded as long as it handles missing key as false.

                                const params = new URLSearchParams(formData);

                                promises.push(fetch(actionUrl, {
                                    method: 'POST',
                                    body: params,
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded',
                                    }
                                }).then(async res => {
                                    if (!res.ok) {
                                        const text = await res.text();
                                        throw new Error(`Server returned ${res.status}: ${text}`);
                                    }
                                    return res;
                                }));
                            }

                            await Promise.all(promises);
                            console.log('All promises resolved');

                            btnSave.innerText = '已儲存! (Saved!)';
                            btnSave.style.background = '#43b581';

                            setTimeout(() => {
                                location.reload();
                            }, 500);

                        } catch (error) {
                            console.error('Save failed:', error);
                            btnSave.innerText = '失敗 (Failed)';
                            btnSave.style.background = '#f04747';
                            alert('儲存失敗：' + error.message);

                            setTimeout(() => {
                                btnSave.innerText = originalText;
                                btnSave.disabled = false;
                                btnSave.style.background = ''; // reset
                            }, 2000);
                        }
                    });
                });
            </script>
            <%- include('partials/cookie_consent') %>
</body>

</html>