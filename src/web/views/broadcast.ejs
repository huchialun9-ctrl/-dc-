<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>
        <%= t('sidebar.broadcast') %> - VX6
    </title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/broadcast' }) %>

        <div class="main-content">
            <div class="topbar">
                <div class="topbar-left">
                    <h2 class="text-gradient">
                        <%= t('sidebar.broadcast') %>
                    </h2>
                </div>
                <div class="user-menu">
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar"
                            class="user-avatar">
                        <% } %>
                            <span>
                                <%= user.username %>
                            </span>
                </div>
            </div>

            <div style="max-width: 900px;">
                <div class="premium-card">
                    <div class="card-header">
                        <i class="fa-solid fa-bullhorn" style="color: #F43F5E;"></i>
                        <h3>撰寫全域公告 (Write Global Broadcast)</h3>
                    </div>

                    <form action="/dashboard/broadcast" method="POST">
                        <div class="form-group">
                            <label>公告標題 (Title)</label>
                            <input type="text" name="title" class="modern-input" placeholder="例如：新功能上線！" required>
                        </div>

                        <div class="form-group">
                            <label>內容描述 (Content)</label>
                            <textarea name="description" rows="5" class="modern-input" placeholder="輸入公告詳細內容..."
                                required></textarea>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>崁入顏色 (Embed Color)</label>
                                <input type="color" name="color" value="#6366F1"
                                    style="height: 50px; cursor: pointer; border: none; padding: 2px;">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>選擇目標伺服器 (Target Servers)</label>
                            <div
                                style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem;">
                                <label class="premium-card"
                                    style="padding: 1rem; display: flex; align-items: center; gap: 0.75rem; cursor: pointer; border-radius: 12px; background: rgba(255,255,255,0.03);">
                                    <input type="checkbox" id="select-all" checked style="width: 18px; height: 18px;">
                                    <span style="font-size: 0.9rem; font-weight: 600;">全選 (Select All)</span>
                                </label>
                                <% guilds.forEach(guild=> { %>
                                    <label class="premium-card"
                                        style="padding: 1rem; display: flex; align-items: center; gap: 0.75rem; cursor: pointer; border-radius: 12px; background: rgba(255,255,255,0.03);">
                                        <input type="checkbox" name="target_guilds" value="<%= guild.id %>" checked
                                            class="guild-cb" style="width: 18px; height: 18px;">
                                        <span
                                            style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <%= guild.name %>
                                        </span>
                                    </label>
                                    <% }) %>
                            </div>
                        </div>

                        <div
                            style="margin-top: 3rem; padding: 1.5rem; background: rgba(244, 63, 94, 0.05); border-radius: 16px; border: 1px solid rgba(244, 63, 94, 0.1);">
                            <p
                                style="color: #F43F5E; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                                <i class="fa-solid fa-triangle-exclamation"></i> 注意 (Warning)
                            </p>
                            <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
                                此操作將向所有選定的伺服器發送訊息。發送後無法撤回，請務必確認公告內容。
                            </p>
                        </div>

                        <button type="submit" class="save-btn"
                            style="margin-top: 2rem; width: 100%; justify-content: center; height: 55px; font-size: 1.1rem; background: linear-gradient(135deg, #F43F5E 0%, #E11D48 100%); box-shadow: 0 10px 20px rgba(244, 63, 94, 0.3);">
                            <i class="fa-solid fa-paper-plane"></i> 立即發送 (Broadcast Now)
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('select-all').addEventListener('change', function (e) {
                document.querySelectorAll('.guild-cb').forEach(cb => cb.checked = e.target.checked);
            });
        </script>
</body>

</html>