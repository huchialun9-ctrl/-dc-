<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>選擇伺服器 - VX6</title>
    <link rel="icon" href="/favicon.jpg" type="image/jpeg">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .server-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.2rem;
            padding: 2rem;
        }

        .server-icon-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid rgba(255, 255, 255, 0.1);
            transition: border-color 0.2s;
        }

        .server-card:hover .server-icon-img {
            border-color: var(--accent-color);
        }

        .server-name {
            font-size: 1.2rem;
            color: var(--text-primary);
            margin: 0;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/servers' }) %>

        <div class="main-content">
            <div class="topbar">
                <h2>選擇伺服器</h2>
                <div class="user-menu">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <div class="dashboard-grid">
                <% if (guilds && guilds.length> 0) { %>
                    <% guilds.forEach(guild=> { %>
                        <div class="stat-card server-card">
                            <% if (guild.icon) { %>
                                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png"
                                    class="server-icon-img">
                                <% } else { %>
                                    <div
                                        style="width:80px;height:80px;background:#333;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;color:#ccc;">
                                        <%= guild.name.charAt(0) %>
                                    </div>
                                    <% } %>

                                        <div style="width: 100%;">
                                            <h4 class="server-name">
                                                <%= guild.name %>
                                            </h4>
                                            <div style="margin-top: 1rem;">
                                                <% if (guild.hasBot) { %>
                                                    <a href="/dashboard/settings?guild_id=<%= guild.id %>"
                                                        class="btn-submit"
                                                        style="display:inline-block; text-decoration: none; padding: 0.6rem 1.5rem; font-size: 0.9rem;">
                                                        管理伺服器
                                                    </a>
                                                    <% } else { %>
                                                        <a href="/invite?guild_id=<%= guild.id %>" class="btn-submit"
                                                            style="display:inline-block; text-decoration: none; padding: 0.6rem 1.5rem; font-size: 0.9rem; background: var(--bg-hover); border: 1px solid var(--border-color);">
                                                            <i class="fa-solid fa-plus"></i> 邀請機器人
                                                        </a>
                                                        <% } %>
                                            </div>
                                        </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="glass-panel"
                                    style="grid-column: 1 / -1; text-align: center; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1.5rem;">
                                    <i class="fa-solid fa-ghost"
                                        style="font-size: 4rem; color: var(--text-secondary); opacity: 0.5;"></i>
                                    <div>
                                        <h3 style="margin:0 0 0.5rem 0;">找不到伺服器</h3>
                                        <p style="color: var(--text-secondary); margin:0;">可能您尚未加入任何伺服器，或尚未授權機器人讀取列表。
                                        </p>
                                    </div>
                                    <a href="/auth/discord" class="btn-submit" style="text-decoration:none;">重新授權</a>
                                </div>
                                <% } %>
            </div>
        </div>
</body>

</html>