<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>儀表板 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard' }) %>

        <div class="main-content">
            <!-- Redesigned Topbar -->
            <!-- Status Center (Replaces Hero) -->
            <div class="status-grid">
                <div class="status-widget">
                    <div class="widget-icon">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <div class="widget-data">
                        <h4>服務狀態</h4>
                        <div class="value" style="color: #4ade80;">運作中</div>
                    </div>
                </div>

                <div class="status-widget">
                    <div class="widget-icon">
                        <i class="fa-solid fa-signal"></i>
                    </div>
                    <div class="widget-data">
                        <h4>延遲 (Ping)</h4>
                        <div class="value">
                            <%= Math.floor(Math.random() * 20 + 10) %>ms
                        </div>
                    </div>
                </div>

                <div class="status-widget">
                    <div class="widget-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="widget-data">
                        <h4>總伺服器數</h4>
                        <div class="value">
                            <%= stats.guilds %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Redesigned Topbar -->
            <div class="topbar">
                <div>
                    <h2 class="text-gradient">控制中心</h2>
                    <p style="color: var(--text-secondary); margin: 0;">快速存取核心功能</p>
                </div>
                <!-- User Menu Preserved -->
                <div class="user-menu border-gradient">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <!-- Control Widgets (Replaces Shortcuts) -->
            <div class="shortcuts-grid">
                <!-- Giveaway Widget -->
                <a href="/dashboard/settings" class="glass-panel"
                    style="text-decoration: none; transition: transform 0.2s; border: 1px solid rgba(255,255,255,0.1);">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div
                            style="background: rgba(168, 85, 247, 0.2); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-gift" style="color: #A855F7; font-size: 1.2rem;"></i>
                        </div>
                        <i class="fa-solid fa-arrow-right" style="color: var(--text-muted);"></i>
                    </div>
                    <h3 style="color: white; margin: 0 0 0.5rem 0;">一鍵抽獎</h3>
                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">快速建立與管理抽獎活動。</p>
                </a>

                <!-- Music Widget -->
                <a href="/dashboard/servers" class="glass-panel"
                    style="text-decoration: none; transition: transform 0.2s; border: 1px solid rgba(255,255,255,0.1);"
                    onclick="alert('請先選擇一個伺服器來開啟音樂面板！');">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div
                            style="background: rgba(249, 115, 22, 0.2); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-music" style="color: #F97316; font-size: 1.2rem;"></i>
                        </div>
                        <i class="fa-solid fa-arrow-right" style="color: var(--text-muted);"></i>
                    </div>
                    <h3 style="color: white; margin: 0 0 0.5rem 0;">音樂面板</h3>
                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Web 音樂播放控制器。</p>
                </a>

                <!-- Logs Widget -->
                <a href="/dashboard/logs" class="glass-panel"
                    style="text-decoration: none; transition: transform 0.2s; border: 1px solid rgba(255,255,255,0.1);">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div
                            style="background: rgba(59, 130, 246, 0.2); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-list-ul" style="color: #3B82F6; font-size: 1.2rem;"></i>
                        </div>
                        <i class="fa-solid fa-arrow-right" style="color: var(--text-muted);"></i>
                    </div>
                    <h3 style="color: white; margin: 0 0 0.5rem 0;">系統日誌</h3>
                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">檢視機器人詳細運作紀錄。</p>
                </a>

                <!-- Docs Widget -->
                <a href="/docs" class="glass-panel"
                    style="text-decoration: none; transition: transform 0.2s; border: 1px solid rgba(255,255,255,0.1);">
                    <div
                        style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <div
                            style="background: rgba(34, 197, 94, 0.2); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-book" style="color: #22C55E; font-size: 1.2rem;"></i>
                        </div>
                        <i class="fa-solid fa-arrow-right" style="color: var(--text-muted);"></i>
                    </div>
                    <h3 style="color: white; margin: 0 0 0.5rem 0;">使用手冊</h3>
                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">查看指令與功能說明。</p>
                </a>

            </div>

            <!-- 2. Command Reference (Replaces Stats) -->
            <div class="command-ref-section border-gradient"
                style="margin-top: 2rem; background: var(--bg-card); padding: 2rem; border-radius: var(--card-radius);">
                <div style="margin-bottom: 2rem;">
                    <h3 class="text-gradient"><i class="fa-solid fa-terminal"></i> 所有指令一覽</h3>
                    <p style="color: var(--text-secondary);">機器人目前支援的所有指令與用法說明。</p>
                </div>

                <div class="command-grid">
                    <% commands.forEach(cmd=> { %>
                        <div class="command-item">
                            <div class="cmd-header">
                                <span class="cmd-name">/<%= cmd.name %></span>
                                <span class="cmd-tag">
                                    <%= cmd.permissions %>
                                </span>
                            </div>
                            <p class="cmd-desc">
                                <%= cmd.description %>
                            </p>
                            <div class="cmd-usage">
                                <i class="fa-solid fa-code"></i> 用法: <span>
                                    <%= cmd.usage %>
                                </span>
                            </div>
                        </div>
                        <% }) %>

                            <% if(commands.length===0) { %>
                                <div
                                    style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--text-muted);">
                                    <i class="fa-solid fa-circle-exclamation"
                                        style="font-size: 2rem; margin-bottom: 1rem;"></i>
                                    <p>目前無法讀取指令列表，請確保機器人已啟動。</p>
                                </div>
                                <% } %>
                </div>
            </div>

            <style>
                /* Shortcuts Grid */
                .shortcuts-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                    gap: 1.5rem;
                    margin-bottom: 2rem;
                }

                .shortcut-card {
                    display: flex;
                    align-items: center;
                    padding: 1.5rem;
                    border-radius: 16px;
                    text-decoration: none;
                    color: white;
                    position: relative;
                    overflow: hidden;
                    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                }

                .shortcut-card:hover {
                    transform: translateY(-5px);
                }

                .shortcut-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent);
                    pointer-events: none;
                }

                .shortcut-icon {
                    font-size: 2rem;
                    margin-right: 1rem;
                    width: 50px;
                    text-align: center;
                }

                .shortcut-info h3 {
                    margin: 0 0 0.2rem 0;
                    font-size: 1.2rem;
                }

                .shortcut-info p {
                    margin: 0;
                    opacity: 0.8;
                    font-size: 0.9rem;
                }

                .shortcut-arrow {
                    margin-left: auto;
                    opacity: 0;
                    transform: translateX(-10px);
                    transition: all 0.3s;
                }

                .shortcut-card:hover .shortcut-arrow {
                    opacity: 1;
                    transform: translateX(0);
                }

                /* Gradients */
                .bg-gradient-purple {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                }

                .bg-gradient-orange {
                    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                }

                .bg-gradient-blue {
                    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
                }

                .bg-gradient-green {
                    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
                }

                /* Command List Styles */
                .command-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 1.5rem;
                }

                .command-item {
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px solid var(--border-color);
                    border-radius: 12px;
                    padding: 1.2rem;
                    transition: all 0.2s;
                }

                .command-item:hover {
                    background: rgba(255, 255, 255, 0.06);
                    border-color: var(--accent-color);
                }

                .cmd-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 0.8rem;
                }

                .cmd-name {
                    font-weight: 800;
                    font-family: monospace;
                    color: var(--accent-color);
                    font-size: 1.1rem;
                    background: rgba(88, 101, 242, 0.1);
                    padding: 0.2rem 0.6rem;
                    border-radius: 6px;
                }

                .cmd-tag {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    background: rgba(255, 255, 255, 0.1);
                    padding: 0.2rem 0.5rem;
                    border-radius: 4px;
                    color: var(--text-muted);
                }

                .cmd-desc {
                    color: var(--text-primary);
                    margin-bottom: 1rem;
                    font-size: 0.95rem;
                    line-height: 1.4;
                }

                .cmd-usage {
                    background: rgba(0, 0, 0, 0.3);
                    padding: 0.8rem;
                    border-radius: 6px;
                    font-family: monospace;
                    font-size: 0.85rem;
                    color: var(--text-secondary);
                }

                .cmd-usage span {
                    color: #A5B4FC;
                }
            </style>
            <%- include('partials/cookie_consent') %>
</body>

</html>