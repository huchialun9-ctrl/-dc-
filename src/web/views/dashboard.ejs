<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>儀表板 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard' }) %>

        <div class="main-content">
            <!-- New Hero Banner -->
            <div class="hero-banner">
                <div style="position: relative; z-index: 2;">
                    <h1 style="color: white; font-size: 2.5rem; margin-bottom: 0.5rem; font-weight: 800;">
                        <% const hour=new Date().getHours(); let greeting='你好' ; if (hour < 12) greeting='早安' ; else if
                            (hour < 18) greeting='午安' ; else greeting='晚安' ; %>
                            <%= greeting %>，<%= user.username %>！
                    </h1>
                    <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; max-width: 600px;">
                        歡迎回到 VX6 管理中心。目前一切運作良好，準備好管理您的伺服器了嗎？
                    </p>
                </div>
                <div class="animate-float"
                    style="position: absolute; right: 5%; top: 20%; font-size: 5rem; color: rgba(255,255,255,0.1); z-index: 1;">
                    <i class="fa-solid fa-rocket"></i>
                </div>
            </div>

            <!-- Modern Status Grid -->
            <div class="status-grid-new">
                <div class="status-card-premium">
                    <div class="status-icon-box"
                        style="background: rgba(34, 197, 94, 0.1); color: #22C55E; box-shadow: var(--success-glow);">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <h4
                            style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">
                            系統狀態</h4>
                        <div style="font-size: 1.4rem; font-weight: 700; color: var(--text-primary);">運作中 (Online)</div>
                    </div>
                </div>

                <div class="status-card-premium">
                    <div class="status-icon-box"
                        style="background: rgba(59, 130, 246, 0.1); color: #3B82F6; box-shadow: var(--info-glow);">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <div>
                        <h4
                            style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">
                            網路延遲</h4>
                        <div style="font-size: 1.4rem; font-weight: 700; color: var(--text-primary);">
                            <%= Math.floor(Math.random() * 20 + 10) %>ms
                        </div>
                    </div>
                </div>

                <div class="status-card-premium">
                    <div class="status-icon-box" style="background: rgba(168, 85, 247, 0.1); color: #A855F7;">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <div>
                        <h4
                            style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">
                            託管伺服器</h4>
                        <div style="font-size: 1.4rem; font-weight: 700; color: var(--text-primary);">
                            <%= stats.guilds %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="topbar">
                <div>
                    <h2 class="text-gradient">核心工具箱</h2>
                    <p style="color: var(--text-secondary); margin: 0;">快速捷徑與功能入口</p>
                </div>
                <div class="user-menu border-gradient">
                    <span>
                        <%= user.username %>
                    </span>
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png"
                            alt="Avatar">
                        <% } else { %>
                            <div style="width:32px;height:32px;background:#5865F2;border-radius:50%;"></div>
                            <% } %>
                </div>
            </div>

            <!-- Quick Action Tiles -->
            <div class="shortcuts-grid">
                <div class="glass-panel"
                    style="padding: 2rem; border-radius: 20px; position: relative; overflow: hidden;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 2rem;">
                        <div
                            style="background: rgba(245, 158, 11, 0.2); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-gift" style="color: #F59E0B; font-size: 1.3rem;"></i>
                        </div>
                        <i class="fa-solid fa-gift"
                            style="color: rgba(255,255,255,0.05); font-size: 3.5rem; position: absolute; right: -10px; bottom: -10px;"></i>
                    </div>
                    <h3 style="color: var(--text-primary); margin: 0 0 0.5rem 0; font-size: 1.2rem;">抽獎系統</h3>
                    <p style="color: var(--text-secondary); margin: 0 0 1.5rem 0; font-size: 0.9rem; line-height: 1.5;">
                        管理伺服器的抽獎活動與贈禮設定。</p>
                    <a href="/dashboard/settings?open=giveaway" class="btn-setting"
                        style="display: inline-flex; padding: 0.6rem 1.2rem; font-size: 0.85rem; text-decoration: none;">
                        <i class="fa-solid fa-plus-circle"></i> 建立抽獎
                    </a>
                </div>

                <div class="glass-panel"
                    style="padding: 2rem; border-radius: 20px; position: relative; overflow: hidden;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 2rem;">
                        <div
                            style="background: rgba(236, 72, 153, 0.2); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-play" style="color: #EC4899; font-size: 1.3rem;"></i>
                        </div>
                        <i class="fa-solid fa-music"
                            style="color: rgba(255,255,255,0.05); font-size: 3.5rem; position: absolute; right: -10px; bottom: -10px;"></i>
                    </div>
                    <h3 style="color: var(--text-primary); margin: 0 0 0.5rem 0; font-size: 1.2rem;">音樂控制</h3>
                    <p style="color: var(--text-secondary); margin: 0 0 1.5rem 0; font-size: 0.9rem; line-height: 1.5;">
                        控制正在播放的曲目與音量。</p>
                    <a href="/dashboard/servers" class="btn-setting"
                        style="display: inline-flex; padding: 0.6rem 1.2rem; font-size: 0.85rem; text-decoration: none; background: #EC4899; color: white;">
                        <i class="fa-solid fa-sliders"></i> 開啟控制器
                    </a>
                </div>

                <div class="glass-panel"
                    style="padding: 2rem; border-radius: 20px; position: relative; overflow: hidden;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 2rem;">
                        <div
                            style="background: rgba(14, 165, 233, 0.2); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-file-invoice" style="color: #0EA5E9; font-size: 1.3rem;"></i>
                        </div>
                        <i class="fa-solid fa-list"
                            style="color: rgba(255,255,255,0.05); font-size: 3.5rem; position: absolute; right: -10px; bottom: -10px;"></i>
                    </div>
                    <h3 style="color: var(--text-primary); margin: 0 0 0.5rem 0; font-size: 1.2rem;">系統日誌</h3>
                    <p style="color: var(--text-secondary); margin: 0 0 1.5rem 0; font-size: 0.9rem; line-height: 1.5;">
                        追蹤機器人的指令執行。 </p>
                    <a href="/dashboard/logs" class="btn-setting"
                        style="display: inline-flex; padding: 0.6rem 1.2rem; font-size: 0.85rem; text-decoration: none; background: #0EA5E9; color: white;">
                        <i class="fa-solid fa-eye"></i> 檢視日誌
                    </a>
                </div>
            </div>

            <!-- Activity & Commands Section -->
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; margin-top: 2rem;">
                <!-- Activity Feed -->
                <div class="activity-feed">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                        <h3 style="color: var(--text-primary); margin: 0;"><i class="fa-solid fa-clock-rotate-left"></i>
                            最近活動</h3>
                        <a href="/dashboard/logs"
                            style="color: var(--accent-color); font-size: 0.85rem; text-decoration: none;">全部日誌 <i
                                class="fa-solid fa-angle-right"></i></a>
                    </div>
                    <div class="activity-list">
                        <% recentLogs.forEach(log=> { %>
                            <% let actionUrl='/dashboard/logs' ; let targetGuildId='' ; // Logic to extract guild_id
                                from details if needed later if (log.action.includes('CONFIG'))
                                actionUrl='/dashboard/settings' ; if (log.action==='TICKET' )
                                actionUrl='/dashboard/settings?open=tickets' ; if (log.action==='ECONOMY' )
                                actionUrl='/dashboard/settings?open=economy' ; %>
                                <a href="<%= actionUrl %>" class="activity-item actionable-log"
                                    style="text-decoration: none; color: inherit; display: flex;">
                                    <div class="activity-icon">
                                        <i
                                            class="fa-solid <%= log.action === 'LOGIN' ? 'fa-right-to-bracket' : 'fa-gear' %>"></i>
                                    </div>
                                    <div class="activity-content" style="flex: 1;">
                                        <p><strong>
                                                <%= log.action %>
                                            </strong>: <%= log.details %>
                                        </p>
                                        <span>
                                            <%= new Date(log.created_at).toLocaleString() %>
                                        </span>
                                    </div>
                                    <div class="activity-arrow">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </div>
                                </a>
                                <% }) %>
                                    <% if(recentLogs.length===0) { %>
                                        <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
                                            暫無最近活動紀錄。
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Featured Instructions -->
                <div class="glass-panel" style="padding: 2rem; border-radius: 24px;">
                    <h3 style="color: var(--text-primary); margin-bottom: 1.5rem;"><i class="fa-solid fa-lightbulb"></i>
                        快速提示</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <div
                            style="padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                            <h4 style="color: var(--accent-color); margin: 0 0 0.5rem 0; font-size: 0.95rem;">自定義指令</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">前往「設定 ->
                                自定義指令」建立專屬的自動回應指令。</p>
                        </div>
                        <div
                            style="padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                            <h4 style="color: #4ade80; margin: 0 0 0.5rem 0; font-size: 0.95rem;">AI 聊天功能</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">在設定中開啟 AI
                                插件，並指定一個頻道即可開始對話。</p>
                        </div>
                        <div
                            style="padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                            <h4 style="color: #f472b6; margin: 0 0 0.5rem 0; font-size: 0.95rem;">等級與經濟</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">
                                開啟插件後，成員即可透過發言或指令獲得經驗與金幣。</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Command List Collapsable (Moved to Bottom) -->
            <div class="command-ref-section"
                style="margin-top: 3rem; opacity: 0.6; transition: opacity 0.3s; cursor: help;"
                onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
                <div style="margin-bottom: 2rem;">
                    <h3 style="color: var(--text-primary);"><i class="fa-solid fa-terminal"></i> 指令快速手冊</h3>
                </div>
                <div class="command-grid">
                    <% commands.forEach(cmd=> { %>
                        <div class="command-item">
                            <div class="cmd-header">
                                <span class="cmd-name">/<%= cmd.name %></span>
                            </div>
                            <p class="cmd-desc" style="font-size: 0.85rem; margin-top: 0.5rem;">
                                <%= cmd.description %>
                            </p>
                        </div>
                        <% }) %>
                </div>
            </div>

            <style>
                /* Shortcuts Grid */
                .shortcuts-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                    gap: 1.5rem;
                    margin-bottom: 2rem;
                }

                .shortcut-card {
                    display: flex;
                    align-items: center;
                    padding: 1.5rem;
                    border-radius: 16px;
                    text-decoration: none;
                    color: white;
                    position: relative;
                    overflow: hidden;
                    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                }

                .shortcut-card:hover {
                    transform: translateY(-5px);
                }

                .shortcut-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent);
                    pointer-events: none;
                }

                .shortcut-icon {
                    font-size: 2rem;
                    margin-right: 1rem;
                    width: 50px;
                    text-align: center;
                }

                .shortcut-info h3 {
                    margin: 0 0 0.2rem 0;
                    font-size: 1.2rem;
                }

                .shortcut-info p {
                    margin: 0;
                    opacity: 0.8;
                    font-size: 0.9rem;
                }

                .shortcut-arrow {
                    margin-left: auto;
                    opacity: 0;
                    transform: translateX(-10px);
                    transition: all 0.3s;
                }

                .shortcut-card:hover .shortcut-arrow {
                    opacity: 1;
                    transform: translateX(0);
                }

                /* Gradients */
                .bg-gradient-purple {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                }

                .bg-gradient-orange {
                    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                }

                .bg-gradient-blue {
                    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
                }

                .bg-gradient-green {
                    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
                }

                /* Command List Styles */
                .command-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 1.5rem;
                }

                .command-item {
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px solid var(--border-color);
                    border-radius: 12px;
                    padding: 1.2rem;
                    transition: all 0.2s;
                }

                .command-item:hover {
                    background: rgba(255, 255, 255, 0.06);
                    border-color: var(--accent-color);
                }

                .cmd-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 0.8rem;
                }

                .cmd-name {
                    font-weight: 800;
                    font-family: monospace;
                    color: var(--accent-color);
                    font-size: 1.1rem;
                    background: rgba(88, 101, 242, 0.1);
                    padding: 0.2rem 0.6rem;
                    border-radius: 6px;
                }

                .cmd-tag {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    background: rgba(255, 255, 255, 0.1);
                    padding: 0.2rem 0.5rem;
                    border-radius: 4px;
                    color: var(--text-muted);
                }

                .cmd-desc {
                    color: var(--text-primary);
                    margin-bottom: 1rem;
                    font-size: 0.95rem;
                    line-height: 1.4;
                }

                .cmd-usage {
                    background: rgba(0, 0, 0, 0.3);
                    padding: 0.8rem;
                    border-radius: 6px;
                    font-family: monospace;
                    font-size: 0.85rem;
                    color: var(--text-secondary);
                }

                .cmd-usage span {
                    color: #A5B4FC;
                }
            </style>
            <%- include('partials/cookie_consent') %>
</body>

</html>