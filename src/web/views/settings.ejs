<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <title>控制台 - VX6</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="stylesheet" href="/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&family=Noto+Sans+TC:wght@400;500;700&family=Kalam:wght@300;400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .plugin-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .plugin-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
            background: rgba(18, 18, 22, 0.85);
        }

        .plugin-info {
            padding: 1.5rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            margin-top: 1rem;
        }

        .config-btn-small {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-secondary);
            padding: 0.6rem 1.2rem;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            transition: all 0.3s;
        }

        .config-btn-small:hover {
            background: var(--accent-color);
            color: white;
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { path: '/dashboard/settings' }) %>

        <div class="main-content">
            <!-- Dashboard Header -->
            <div class="topbar">
                <div class="topbar-left">
                    <h2 class="text-gradient" style="font-size: 2.2rem; font-weight: 900;">
                        <i class="fa-solid fa-sliders" style="margin-right: 1rem; opacity: 0.8; font-size: 1.8rem;"></i>
                        <%= mode==='guild' ? guild.name : '系統核心設定' %>
                    </h2>
                    <div
                        style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i class="fa-solid fa-circle-check" style="color: var(--success-color); font-size: 0.8rem;"></i>
                        控制台連線正常 (Connection Secure)
                    </div>
                </div>
                <div class="user-menu" style="padding: 0.6rem 1.5rem; border-radius: 20px;">
                    <% if(user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar"
                            class="user-avatar"
                            style="width: 38px; height: 38px; border: 2px solid rgba(255,255,255,0.1);">
                        <% } else { %>
                            <div
                                style="width:38px;height:38px;background:var(--hero-gradient);border-radius:50%; border: 2px solid rgba(255,255,255,0.1);">
                            </div>
                            <% } %>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-weight: 800; font-size: 0.95rem;">
                                        <%= user.username %>
                                    </span>
                                    <span
                                        style="font-size: 0.75rem; color: var(--text-muted); opacity: 0.8;">管理員模式</span>
                                </div>
                </div>
            </div>

            <% if (mode==='global' ) { %>
                <!-- Global Settings Redesigned -->
                <div class="premium-card" style="max-width: 800px; margin-bottom: 4rem;">
                    <div class="card-header">
                        <div
                            style="width: 50px; height: 50px; background: rgba(251, 191, 36, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-microchip"
                                style="color: var(--warning-color); font-size: 1.5rem;"></i>
                        </div>
                        <div>
                            <h3 style="margin-bottom: 0.25rem;">全域核心設定 (Core Engine)</h3>
                            <p style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">控制 VX6 系統的底層運作參數
                            </p>
                        </div>
                    </div>
                    <form action="/dashboard/settings" method="POST" class="track-changes">
                        <input type="hidden" name="action" value="global_update">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                            <div class="form-group">
                                <label>系統實體名稱</label>
                                <input type="text" value="VX6 Multiverse System" class="modern-input" disabled
                                    style="opacity: 0.6; cursor: not-allowed;">
                            </div>
                            <div class="form-group">
                                <label>核心版本</label>
                                <input type="text" value="v2.4.0-premium" class="modern-input" disabled
                                    style="opacity: 0.6; cursor: not-allowed;">
                            </div>
                        </div>
                        <button type="submit" class="save-btn" style="margin-top: 1rem;">
                            <i class="fa-solid fa-shield-halved"></i> 授權並重新啟動核心
                        </button>
                    </form>
                </div>
                <% } else { %>
                    <!-- General Guild Settings Redesigned -->
                    <div class="premium-card"
                        style="margin-bottom: 4rem; background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);">
                        <div class="card-header">
                            <div
                                style="width: 50px; height: 50px; background: rgba(5, 182, 212, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-server"
                                    style="color: var(--accent-secondary); font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h3 style="margin-bottom: 0.25rem;">伺服器基本框架 (Basic Framework)</h3>
                                <p style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">配置伺服器的基本互動邏輯
                                </p>
                            </div>
                        </div>
                        <form action="/dashboard/settings" method="POST" class="track-changes"
                            style="display: flex; gap: 2.5rem; align-items: flex-end; flex-wrap: wrap;">
                            <input type="hidden" name="action" value="update_language">
                            <input type="hidden" name="guild_id" value="<%= guild.id %>">
                            <div class="form-group" style="flex: 1; min-width: 300px; margin-bottom: 0;">
                                <label>偏好語系 (Interaction Language)</label>
                                <select name="language" class="modern-input" required>
                                    <option value="zh" <%=settings.language==='zh' ? 'selected' : '' %>>繁體中文 (Taiwan) -
                                        精準翻譯</option>
                                    <option value="en" <%=settings.language==='en' ? 'selected' : '' %>>English
                                        (Universal) - Original</option>
                                </select>
                            </div>
                            <button type="submit" class="save-btn" style="height: 54px;">
                                <i class="fa-solid fa-square-check"></i> 同步基本資料
                            </button>
                        </form>
                    </div>

                    <!-- Plugin Grid -->
                    <div id="modules-grid" class="dashboard-grid">

                        <!-- 1. Announcement Plugin -->
                        <div class="premium-card plugin-card" data-module="announcement">
                            <div class="designer-tip">重要廣播</div>
                            <div class="card-illustration">
                                <img src="/img/illustrations/announcement.png" alt="Announcement Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(248, 113, 113, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-bullhorn" style="color: #F87171; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>廣播中心</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    像電台一樣，對伺服器發送精美的崁入式公告。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.announcement_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.announcement_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="announcement_enabled"
                                            <%=settings.announcement_enabled ? 'checked' : '' %>
                                        onchange="togglePlugin('announcement', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- Quick Sender Card -->
                                <% if (settings.announcement_enabled) { %>
                                    <div class="premium-card"
                                        style="padding: 1.2rem; background: rgba(255,255,255,0.02); margin-top: 1rem; border: 1px solid rgba(255,255,255,0.05); border-radius: 16px;">
                                        <div
                                            style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                                            <i class="fa-solid fa-paper-plane"
                                                style="color: var(--accent-secondary); font-size: 0.8rem;"></i>
                                            <span
                                                style="font-size: 0.75rem; font-weight: 800; opacity: 0.7;">即時廣播發送器</span>
                                        </div>
                                        <form action="/dashboard/settings" method="POST">
                                            <input type="hidden" name="action" value="send_announcement">
                                            <input type="hidden" name="guild_id" value="<%= guild.id %>">
                                            <div class="form-group" style="margin-bottom: 0.8rem;">
                                                <select name="channel_id" class="modern-input"
                                                    style="padding: 0.5rem; font-size: 0.8rem;" required>
                                                    <option value="">選擇接收頻道...</option>
                                                    <% channels.forEach(c=> { %>
                                                        <option value="<%= c.id %>"># <%= c.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <div class="form-group" style="margin-bottom: 1rem;">
                                                <textarea name="description" class="modern-input" rows="2"
                                                    placeholder="這是一則由管理員發出的廣播..."
                                                    style="padding: 0.6rem; font-size: 0.8rem;" required></textarea>
                                            </div>
                                            <button type="submit" class="save-btn"
                                                style="width: 100%; height: 36px; font-size: 0.8rem; justify-content: center;">
                                                立即發佈廣播
                                            </button>
                                        </form>
                                    </div>
                                    <% } %>
                                        <div class="handwritten-note">"讓大家都能聽見你的聲音!"</div>
                            </div>
                        </div>

                        <!-- 2. Welcome Plugin -->
                        <div class="premium-card plugin-card" data-module="welcome">
                            <div class="card-illustration">
                                <img src="/img/illustrations/welcome.png" alt="Welcome Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(99, 102, 241, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-door-open" style="color: #6366f1; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>迎接新朋友</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    迎接每位新加入的成員，營造溫暖的第一印象。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.welcome_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.welcome_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="welcome_enabled" <%=settings.welcome_enabled
                                            ? 'checked' : '' %>
                                        onchange="togglePlugin('welcome', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <form action="/dashboard/settings" method="POST" class="track-changes">
                                    <input type="hidden" name="action" value="update_welcome">
                                    <input type="hidden" name="guild_id" value="<%= guild.id %>">

                                    <div class="form-group" style="margin-bottom: 1.5rem;">
                                        <label style="font-size: 0.75rem;">迎接頻道</label>
                                        <select name="welcome_channel_id" class="modern-input"
                                            style="padding: 0.6rem; font-size: 0.8rem;">
                                            <% channels.forEach(c=> { %>
                                                <option value="<%= c.id %>" <%=settings.welcome_channel_id===c.id
                                                    ? 'selected' : '' %>># <%= c.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label style="font-size: 0.75rem;">迎接訊息 (支援變數 like {user})</label>
                                        <textarea name="welcome_message" class="modern-input" rows="3"
                                            placeholder="歡迎來到伺服器，{user}! 希望你在這裡玩得愉快。"
                                            style="padding: 0.6rem; font-size: 0.8rem;"><%= settings.welcome_message %></textarea>
                                    </div>
                                </form>
                                <div class="handwritten-note">"溫暖的開始是成功的全部~"</div>
                            </div>
                        </div>

                        <!-- 3. Economy Plugin -->
                        <div class="premium-card plugin-card" data-module="economy">
                            <div class="card-illustration">
                                <img src="/img/illustrations/economy.png" alt="Economy Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(251, 191, 36, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-coins" style="color: #fbbf24; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>數位金庫</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    伺服器專屬經濟體系。讓成員透過參與互動賺取虛擬幣。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.economy_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.economy_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="economy_enabled" <%=settings.economy_enabled
                                            ? 'checked' : '' %>
                                        onchange="togglePlugin('economy', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="plugin-info">
                                    <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;">
                                        <i class="fa-solid fa-wallet" style="color: #fbbf24; opacity: 0.5;"></i>
                                        <span style="font-size: 0.85rem; color: var(--text-secondary);">已完成系統對接</span>
                                    </div>
                                    <button class="config-btn-small" onclick="openConfig('economy')"
                                        style="width: 100%; justify-content: center;">
                                        <i class="fa-solid fa-gear"></i> 管理金庫與物價
                                    </button>
                                </div>
                                <div class="handwritten-note">"大家的口袋都很深呢!"</div>
                            </div>
                        </div>

                        <!-- 4. AI Chat Plugin -->
                        <div class="premium-card plugin-card" data-module="ai">
                            <div class="card-illustration">
                                <img src="/img/illustrations/ai.png" alt="AI Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(167, 139, 250, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-brain" style="color: #a78bfa; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>數位大腦</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    深度集成神經網絡模型。讓機器人能像人類一樣對話與理解。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.ai_chat_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.ai_chat_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="ai_chat_enabled" <%=settings.ai_chat_enabled
                                            ? 'checked' : '' %>
                                        onchange="togglePlugin('ai_chat', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="plugin-info">
                                    <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;">
                                        <i class="fa-solid fa-microchip" style="color: #a78bfa; opacity: 0.5;"></i>
                                        <span style="font-size: 0.85rem; color: var(--text-secondary);">模型負載正常</span>
                                    </div>
                                    <button class="config-btn-small" onclick="openConfig('ai')"
                                        style="width: 100%; justify-content: center;">
                                        <i class="fa-solid fa-sliders"></i> 調校神經網絡參數
                                    </button>
                                </div>
                                <div class="handwritten-note">"我有我自己的靈魂..."</div>
                            </div>
                        </div>

                        <!-- 5. AutoMod Plugin -->
                        <div class="premium-card plugin-card" data-module="automod">
                            <div class="card-illustration">
                                <img src="/img/illustrations/automod.png" alt="AutoMod Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(52, 211, 153, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-shield-halved"
                                            style="color: #34d399; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>智慧守護</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    7/24 小時無間斷的安全監控。自動過濾惡意言論，維護社群和平。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.automod_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.automod_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="automod_enabled" <%=settings.automod_enabled
                                            ? 'checked' : '' %>
                                        onchange="togglePlugin('automod', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="plugin-info">
                                    <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;">
                                        <i class="fa-solid fa-bolt" style="color: #34d399; opacity: 0.5;"></i>
                                        <span style="font-size: 0.85rem; color: var(--text-secondary);">實時攔截模式已啟動</span>
                                    </div>
                                    <button class="config-btn-small" onclick="openConfig('automod')"
                                        style="width: 100%; justify-content: center;">
                                        <i class="fa-solid fa-shield-check"></i> 設定規則與黑名單
                                    </button>
                                </div>
                                <div class="handwritten-note">"我的防禦無堅不摧。"</div>
                            </div>
                        </div>

                        <!-- 6. Music Plugin -->
                        <div class="premium-card plugin-card" data-module="music">
                            <div class="card-illustration">
                                <img src="/img/illustrations/music.png" alt="Music Illustration">
                            </div>
                            <div class="card-content-wrap">
                                <div class="card-header">
                                    <div
                                        style="width: 32px; height: 32px; background: rgba(251, 146, 60, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-music" style="color: #fb923c; font-size: 0.9rem;"></i>
                                    </div>
                                    <h3>音樂饗宴</h3>
                                </div>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1.5rem;">
                                    高品質的串流播放。無論是放鬆還是派對，這裡都有最好的旋律。</p>

                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">
                                        運行狀態: <span
                                            class="<%= settings.music_enabled ? 'status-enabled' : 'status-disabled' %>">
                                            <%= settings.music_enabled ? '在線' : '離線' %>
                                        </span>
                                    </span>
                                    <label class="switch">
                                        <input type="checkbox" name="music_enabled" <%=settings.music_enabled
                                            ? 'checked' : '' %>
                                        onchange="togglePlugin('music', this.checked)">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="plugin-info">
                                    <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;">
                                        <i class="fa-solid fa-volume-high" style="color: #fb923c; opacity: 0.5;"></i>
                                        <span style="font-size: 0.85rem; color: var(--text-secondary);">音質優化引擎已開展</span>
                                    </div>
                                    <button class="config-btn-small" onclick="openConfig('music')"
                                        style="width: 100%; justify-content: center;">
